<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PlanificApp.MainWindow"
        Title="PlanificApp - Registro de Usuario"
        Width="400" Height="500"
        WindowStartupLocation="CenterScreen"
        Background="#1e1e1e">

    <StackPanel Margin="30" Spacing="15" VerticalAlignment="Center">
        <TextBlock Text="Crear Cuenta" FontSize="28" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <TextBlock Text="Nombre Completo" Foreground="#aaaaaa" FontSize="12"/>
        <TextBox Name="TxtNombre" Watermark="Ej: Ian Cortés" />

        <TextBlock Text="Correo Electrónico" Foreground="#aaaaaa" FontSize="12"/>
        <TextBox Name="TxtCorreo" Watermark="ejemplo@correo.com" />

        <TextBlock Text="Contraseña" Foreground="#aaaaaa" FontSize="12"/>
        <TextBox Name="TxtPassword" PasswordChar="*" Watermark="Mínimo 6 caracteres" />

        <Button Content="Registrar" 
                Click="OnRegistrarClick"
                Background="#2d5a27" Foreground="White" 
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" 
                Padding="10" Margin="0,20,0,0"/>
        
        <TextBlock Name="LblStatus" HorizontalAlignment="Center" Margin="0,10,0,0" />
    </StackPanel>
</Window>