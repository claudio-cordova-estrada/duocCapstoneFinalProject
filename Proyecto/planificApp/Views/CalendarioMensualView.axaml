<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="planificApp.Views.CalendarioMensualView"
             xmlns:vm="clr-namespace:planificApp.ViewModels"
             xmlns:models="clr-namespace:PlanificApp.Models"
             xmlns:converters="clr-namespace:planificApp.Converters"
             x:DataType="vm:CalendarioMensualViewModel">

    <UserControl.Resources>
        <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter"/>
    </UserControl.Resources>

    <Border Background="{DynamicResource AppBackground}">
        <Grid ColumnDefinitions="260, *">
            
            <!-- ========================================== -->
            <!-- COLUMNA 0: PANEL LATERAL AGRUPADO          -->
            <!-- ========================================== -->
            <Border Grid.Column="0" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0 0 1 0" Padding="15">
                <Grid RowDefinitions="Auto, *">
                    <TextBlock Grid.Row="0" Text="Tareas" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="5 0 0 20"/>
                    
                    <ScrollViewer Grid.Row="1">
    <StackPanel>
        
        <!-- 1. TUS ÁREAS NORMALES -->
        <ItemsControl ItemsSource="{Binding AreasSidebar}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AreaSidebarGroup">
                    <StackPanel Margin="0 0 0 16">
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0 0 0 8">
                            <Ellipse Width="10" Height="10" Fill="{Binding ColorHex, FallbackValue='#6366f1'}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding NombreArea}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <ItemsControl ItemsSource="{Binding Tareas}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TareaDetalleSidebar">
                                    <Border Background="{DynamicResource PillBackground}" BorderBrush="{DynamicResource PillBorder}" BorderThickness="1" CornerRadius="4" Padding="10 8" Margin="18 0 0 6">
                                        <TextBlock Text="{Binding Titulo}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 2. NUEVA SECCIÓN: TAREAS VENCIDAS -->
        <!-- Solo se muestra si "HayTareasVencidas" es True -->
        <StackPanel IsVisible="{Binding HayTareasVencidas}">
            
            <!-- Línea separadora sutil -->
            <Border Height="1" Background="{DynamicResource BorderSubtle}" Margin="0 4 0 16"/>

            <!-- Cabecera Roja -->
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0 0 0 8">
                <Ellipse Width="10" Height="10" Fill="#ef4444" VerticalAlignment="Center"/>
                <TextBlock Text="Vencidas" FontSize="13" FontWeight="Bold" Foreground="#ef4444" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Lista con diseño de urgencia -->
            <ItemsControl ItemsSource="{Binding TareasVencidas}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TareaDetalleSidebar">
                        <!-- El fondo rojizo oscuro resalta sobre el gris de las tareas normales -->
                        <Border Background="{DynamicResource DangerBackground}" BorderBrush="{DynamicResource DangerBorder}" BorderThickness="1" CornerRadius="4" Padding="10 8" Margin="18 0 0 6">
                            <TextBlock Text="{Binding Titulo}" FontSize="12" Foreground="{DynamicResource DangerForeground}" FontWeight="Medium" TextWrapping="Wrap"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            
        </StackPanel>

    </StackPanel>
</ScrollViewer>
                </Grid>
            </Border>

            <!-- ========================================== -->
            <!-- COLUMNA 1: CALENDARIO PRINCIPAL            -->
            <!-- ========================================== -->
            <DockPanel Grid.Column="1">
                <!-- Header Dinámico -->
                <Border DockPanel.Dock="Top" Padding="10 14" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0 0 0 1">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Button Grid.Column="0" Command="{Binding MesAnteriorCommand}" Classes="transparent" Padding="4" VerticalAlignment="Center">
                            <Label Classes="icon-only" Content="&#xE51A;" FontSize="16" Foreground="{DynamicResource TextSecondary}"/>
                        </Button>
                        <TextBlock Grid.Column="1" Text="{Binding NombreMesAnio}" FontSize="16" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Command="{Binding MesSiguienteCommand}" Classes="transparent" Padding="4" VerticalAlignment="Center">
                            <Label Classes="icon-only" Content="&#xE52C;" FontSize="16" Foreground="{DynamicResource TextSecondary}"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- LEYENDA INFERIOR DINÁMICA -->
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 16 16 16" Spacing="16">
                    <!-- Este ItemsControl dibuja las áreas del usuario automáticamente -->
                    <ItemsControl ItemsSource="{Binding AreasDelUsuario}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="16"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <!-- Importante: Avalonia necesita saber qué objeto lee aquí -->
                            <DataTemplate x:DataType="models:AreaInteres">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Ellipse Width="10" Height="10" Fill="{Binding ColorHex, FallbackValue='#6366f1'}" />
                                    <TextBlock Text="{Binding Nombre}" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="16 0 0 0">
                        <Ellipse Width="10" Height="10" Fill="#ef4444" /> <!-- Rojo para vencidas -->
                        <TextBlock Text="Vencida" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Cuadrícula Dinámica del Calendario -->
                <Border Classes="card" Padding="0" Margin="16 16 16 0">
                    <Grid RowDefinitions="Auto,*">
                        <UniformGrid Grid.Row="0" Columns="7" Rows="1" Background="{DynamicResource CalendarDayHeader}">
                            <TextBlock Text="Lun" FontSize="12" Foreground="{DynamicResource TextDisabled}" HorizontalAlignment="Center" Margin="0 10"/>
                            <TextBlock Text="Mar" FontSize="12" Foreground="{DynamicResource TextDisabled}" HorizontalAlignment="Center" Margin="0 10"/>
                            <TextBlock Text="Mié" FontSize="12" Foreground="{DynamicResource TextDisabled}" HorizontalAlignment="Center" Margin="0 10"/>
                            <TextBlock Text="Jue" FontSize="12" Foreground="{DynamicResource TextDisabled}" HorizontalAlignment="Center" Margin="0 10"/>
                            <TextBlock Text="Vie" FontSize="12" Foreground="{DynamicResource TextDisabled}" HorizontalAlignment="Center" Margin="0 10"/>
                            <TextBlock Text="Sáb" FontSize="12" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0 10"/>
                            <TextBlock Text="Dom" FontSize="12" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0 10"/>
                        </UniformGrid>

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Dias}" Background="{DynamicResource CalendarDayBackground}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7" Rows="6"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CalendarioDiaViewModel">
                                    <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0 0 1 1" Padding="4" MinHeight="90">
                                        <StackPanel Spacing="4">
                                            
                                            <!-- Número del día -->
                                            <TextBlock Text="{Binding NumeroDia}" 
                                                       FontSize="13" 
                                                       Margin="4 2 0 4"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       Opacity="{Binding EsMesActual, Converter={StaticResource BoolToOpacityConverter}}"/>

                                            <!-- Puntitos de color: uno por cada área trabajada ese día -->
                                            <ItemsControl ItemsSource="{Binding PuntosAreas}" Margin="4 0 0 0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>

                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:PuntoAreaDia">
                                                        <Ellipse Width="9" Height="9" Margin="2"
                                                                 Fill="{Binding ColorHex}"
                                                                 ToolTip.Tip="{Binding NombreArea}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>