<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="580"
        x:Class="planificApp.Views.NewTaskWindow"
        xmlns:vm="clr-namespace:planificApp.ViewModels"
        x:DataType="vm:NewTaskViewModel"
        Title="Nueva tarea"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        Width="600"
        CanResize="False"
        Background="{DynamicResource ModalBackground}">

    <Border Classes="modal-panel" Margin="0" Padding="24">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="14">

            <TextBlock Text="Nueva tarea" FontSize="16" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>

            <StackPanel Spacing="4">
                <TextBlock Text="NOMBRE" FontSize="11" Foreground="{DynamicResource TextDisabled}" LetterSpacing="0.6"/>
                <TextBox Text="{Binding Nombre}" FontSize="14" PlaceholderText="Nombre de la tarea" Foreground="{DynamicResource TextSecondary}" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}"/>
            </StackPanel>
            
            <StackPanel Spacing="4">
                <TextBlock Text="ÁREA DE INTERÉS" FontSize="11" Foreground="{DynamicResource TextDisabled}" LetterSpacing="0.6"/>
                <ComboBox x:Name="CmbAreaInteres" SelectedIndex="0" FontSize="13" Foreground="{DynamicResource TextSecondary}" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" HorizontalAlignment="Stretch"/>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="FECHA DE INICIO" FontSize="11" Foreground="{DynamicResource TextDisabled}" LetterSpacing="0.6"/>
                <Grid ColumnDefinitions="*,Auto">
                    <CalendarDatePicker x:Name="PickerFecInicio" SelectedDate="{Binding FecInicio}" Grid.Column="0" FontSize="14" Foreground="{DynamicResource TextSecondary}" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" PlaceholderText="Selecciona fecha de inicio" HorizontalAlignment="Stretch"/>
                    <Button Grid.Column="1" Classes="transparent" Padding="4" VerticalAlignment="Center" Click="ClearFecInicio_Click" Cursor="Hand">
                        <Label FontFamily="{DynamicResource Phosphor}" FontSize="12" Content="&#xE4FA;" Foreground="{DynamicResource TextDisabled}" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="FECHA LIMITE" FontSize="11" Foreground="{DynamicResource TextDisabled}" LetterSpacing="0.6"/>
                <Grid ColumnDefinitions="*,Auto">
                    <CalendarDatePicker x:Name="PickerFecLimite" SelectedDate="{Binding FecLimite}" Grid.Column="0" FontSize="14" Foreground="{DynamicResource TextSecondary}" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" PlaceholderText="Selecciona fecha limite" HorizontalAlignment="Stretch"/>
                    <Button Grid.Column="1" Classes="transparent" Padding="4" VerticalAlignment="Center" Click="ClearFecLimite_Click" Cursor="Hand">
                        <Label FontFamily="{DynamicResource Phosphor}" FontSize="12" Content="&#xE4FA;" Foreground="{DynamicResource TextDisabled}" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </StackPanel>

            <Grid ColumnDefinitions="*,16,*">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="HORA INICIO" FontSize="11" Foreground="{DynamicResource TextDisabled}" LetterSpacing="0.6"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TimePicker x:Name="PickerHoraInicio" SelectedTime="{Binding HoraInicio}" Grid.Column="0" ClockIdentifier="24HourClock" FontSize="14" Foreground="{DynamicResource TextSecondary}" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" MaxWidth="170"/>
                        <Button Grid.Column="1" Classes="transparent" Padding="2" VerticalAlignment="Center" Click="ClearHoraInicio_Click" Cursor="Hand">
                            <Label FontFamily="{DynamicResource Phosphor}" FontSize="12" Content="&#xE4FA;" Foreground="{DynamicResource TextDisabled}" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4">
                    <TextBlock Text="HORA FIN" FontSize="11" Foreground="{DynamicResource TextDisabled}" LetterSpacing="0.6"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TimePicker x:Name="PickerHoraFin" SelectedTime="{Binding HoraFin}" Grid.Column="0" ClockIdentifier="24HourClock" FontSize="14" Foreground="{DynamicResource TextSecondary}" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" MaxWidth="170"/>
                        <Button Grid.Column="1" Classes="transparent" Padding="2" VerticalAlignment="Center" Click="ClearHoraFin_Click" Cursor="Hand">
                            <Label FontFamily="{DynamicResource Phosphor}" FontSize="12" Content="&#xE4FA;" Foreground="{DynamicResource TextDisabled}" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>

            <StackPanel Spacing="4">
                <TextBlock Text="UBICACIÓN" FontSize="11" Foreground="{DynamicResource TextDisabled}" LetterSpacing="0.6"/>
                <ComboBox FontSize="13" Foreground="{DynamicResource TextSecondary}" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding MisUbicaciones}" SelectedItem="{Binding UbicacionDisplay}"/>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="TIEMPO ESTIMADO" FontSize="11" Foreground="{DynamicResource TextDisabled}" LetterSpacing="0.6"/>
                <ComboBox FontSize="13" Foreground="{DynamicResource TextSecondary}" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding Tiempos}" SelectedItem="{Binding TiempoDisplay}"/>
            </StackPanel>
            
            <StackPanel Spacing="4">
                <TextBlock Text="ACTIVIDAD FÍSICA" FontSize="11" Foreground="{DynamicResource TextDisabled}" LetterSpacing="0.6"/>
                <ComboBox FontSize="13" Foreground="{DynamicResource TextSecondary}" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding NivelesActividadFisica}" SelectedItem="{Binding ActividadFisicaDisplay}"/>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="ACTIVIDAD MENTAL" FontSize="11" Foreground="{DynamicResource TextDisabled}" LetterSpacing="0.6"/>
                <ComboBox FontSize="13" Foreground="{DynamicResource TextSecondary}" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding NivelesActividadMental}" SelectedItem="{Binding ActividadMentalDisplay}"/>
            </StackPanel>

            <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" FontSize="12" Foreground="{DynamicResource DangerForeground}" HorizontalAlignment="Center" TextWrapping="Wrap"/>

            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0 6 0 0">
                <Border Width="0" Grid.Column="0"/>
                <Button Grid.Column="1" Classes="transparent" Margin="0 0 8 0" Click="CancelButton_Click" Content="Cancelar"/>
                <Button Grid.Column="2" Classes="accent" Click="SaveButton_Click" Content="Guardar"/>
            </Grid>

        </StackPanel>
        </ScrollViewer>
    </Border>
</Window>