<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="800"
             x:Class="planificApp.Views.EstadisticasView"
             x:Name="EstadisticasRoot"
             xmlns:vm="clr-namespace:planificApp.ViewModels"
             x:DataType="vm:EstadisticasViewModel">

    <UserControl.Styles>
        <Style Selector="ListBox.pill-list">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        
        <Style Selector="ListBox.pill-list ListBoxItem">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="16 6"
                            Margin="0 0 8 8"
                            Cursor="Hand">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        
        <Style Selector="ListBox.pill-list ListBoxItem">
            <Setter Property="Background" Value="{DynamicResource PillBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PillBorder}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDisabled}"/>
        </Style>
        
        <Style Selector="ListBox.pill-list ListBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
        </Style>
        
        <Style Selector="ListBox.pill-list ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource AdminAccentBackground}"/> 
            <Setter Property="BorderBrush" Value="{DynamicResource AdminAccent}"/> 
            <Setter Property="Foreground" Value="{DynamicResource AdminAccent}"/>
        </Style>
        <!-- Centra verticalmente el texto/placeholder del buscador (AutoCompleteBox) -->
        <Style Selector="AutoCompleteBox /template/ TextBox#PART_TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource AppBackground}">
        <ScrollViewer>
            <StackPanel Spacing="18" Margin="28 26">

                <Grid ColumnDefinitions="*, Auto" Margin="0 0 0 10">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Estadísticas de usuario" FontSize="24" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Datos de uso · actualizado hoy" FontSize="14" Foreground="{DynamicResource TextDisabled}" Margin="0 -2 0 0"/>
                    </StackPanel>

                    <Border Grid.Column="1" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="8" Width="300" Height="42" VerticalAlignment="Center">
                        <Grid ColumnDefinitions="Auto, *">
                            <Label Grid.Column="0" Content="&#xE318;" FontFamily="{DynamicResource Phosphor}" FontSize="20" Foreground="{DynamicResource TextDisabled}" VerticalAlignment="Center" Margin="12 0 4 0"/>
                            <AutoCompleteBox Grid.Column="1" 
                 Text="{Binding TextoBusqueda}" 
                 SelectedItem="{Binding SugerenciaSeleccionada}"
                 ItemsSource="{Binding SugerenciasBusqueda}"
                 PlaceholderText="Buscar nombre, correo, ID..." 
                 Background="Transparent" 
                 BorderThickness="0" 
                 FontSize="13" 
                 Foreground="{DynamicResource TextPrimary}"
                 VerticalAlignment="Center"
                 Margin="0"
                 FilterMode="Contains"
                 MinimumPrefixLength="1">
                             <AutoCompleteBox.ItemTemplate>
        <DataTemplate>
            <TextBlock Text="{Binding .}" Foreground="{DynamicResource TextPrimary}" Padding="4"/>
        </DataTemplate>
    </AutoCompleteBox.ItemTemplate>
    
</AutoCompleteBox>
                        </Grid>
                    </Border>
                </Grid>

                <StackPanel Spacing="8">
                    <TextBlock Text="REGIÓN" FontSize="12" Foreground="{DynamicResource TextDisabled}" LetterSpacing="0.6"/>
                    <ListBox Classes="pill-list" ItemsSource="{Binding Regiones}" SelectedItem="{Binding RegionSeleccionada}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="COMUNA" FontSize="12" Foreground="{DynamicResource TextDisabled}" LetterSpacing="0.6"/>
                    <ListBox Classes="pill-list" ItemsSource="{Binding Comunas}" SelectedItem="{Binding ComunaSeleccionada}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </StackPanel>

                <Border Classes="card" Padding="16" CornerRadius="10">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*">
                        <Button x:Name="YearLeft" Grid.Column="0" Classes="transparent" Padding="10" VerticalAlignment="Center" Command="{Binding YearLeftCommand}">
                            <Label Content="&#xE51A;" FontFamily="{DynamicResource Phosphor}" FontSize="24" Foreground="{DynamicResource TextMuted}"/>
                        </Button>
                        
                        <TextBlock x:Name="YearLabel" Text="{Binding YearActual}" Grid.Column="1" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="10 0" MinWidth="72" TextAlignment="Center"/>
                        
                        <Button x:Name="YearRight" Grid.Column="2" Classes="transparent" Padding="10" VerticalAlignment="Center" Command="{Binding YearRightCommand}">
                            <Label Content="&#xE52C;" FontFamily="{DynamicResource Phosphor}" FontSize="24" Foreground="{DynamicResource TextMuted}"/>
                        </Button>
                        
                        <Border Grid.Column="3" Width="1" Background="{DynamicResource BorderSubtle}" Margin="14 0"/>
                        <ItemsControl Grid.Column="4" ItemsSource="{Binding Meses}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MesPill">
                                    <Button Classes="pill-rounded admin"
                                            Classes.active="{Binding Seleccionado}"
                                            Classes.disabled="{Binding !Habilitado}"
                                            IsEnabled="{Binding Habilitado}"
                                            Margin="3 0"
                                            x:CompileBindings="False"
                                            Command="{Binding #EstadisticasRoot.DataContext.SeleccionarMesCommand}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="{Binding Nombre}" FontSize="12"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                    
                    <Border Grid.Column="0" Grid.Row="0" Classes="card" Padding="20">
                        <StackPanel>
                            <TextBlock Text="TOTAL USUARIOS" FontSize="12" Foreground="{DynamicResource TextDisabled}" LetterSpacing="0.6"/>
                            <TextBlock x:Name="StatTotalUsuarios" Text="{Binding TotalUsuarios}" FontSize="36" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0 8 0 4"/>
                            <TextBlock Text="registrados en la plataforma" FontSize="13" Foreground="{DynamicResource TextMuted}"/>
                        </StackPanel>
                    </Border>
                    
                    <Border Grid.Column="1" Grid.Row="0" Classes="card" Padding="20">
                        <StackPanel>
                            <TextBlock Text="USUARIOS ACTIVOS" FontSize="12" Foreground="{DynamicResource TextDisabled}" LetterSpacing="0.6"/>
                            <TextBlock x:Name="StatUsuariosActivos" Text="{Binding UsuariosActivos}" FontSize="36" FontWeight="SemiBold" Foreground="{DynamicResource AdminAccent}" Margin="0 8 0 4"/>
                            <TextBlock Text="con actividad reciente" FontSize="13" Foreground="{DynamicResource TextMuted}"/>
                        </StackPanel>
                    </Border>
                    
                    <Border Grid.Column="0" Grid.Row="1" Classes="card" Padding="20">
                        <StackPanel>
                            <TextBlock Text="USAN GENERACIÓN SEMANAL" FontSize="12" Foreground="{DynamicResource TextDisabled}" LetterSpacing="0.6"/>
                            <TextBlock x:Name="StatUsanGen" Text="{Binding UsanGeneracionSemanal}" FontSize="36" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0 8 0 4"/>
                            <TextBlock x:Name="StatUsanGenSub" Text="estimado sobre activos" FontSize="13" Foreground="{DynamicResource TextMuted}"/>
                        </StackPanel>
                    </Border>
                    
                    <Border Grid.Column="1" Grid.Row="1" Classes="card" Padding="20">
                        <StackPanel>
                            <TextBlock Text="CAMBIOS / GENERACIÓN" FontSize="12" Foreground="{DynamicResource TextDisabled}" LetterSpacing="0.6"/>
                            <TextBlock x:Name="StatCambiosGen" Text="{Binding CambiosPorGeneracion, StringFormat={}{0:F1}}" FontSize="36" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0 8 0 4"/>
                            <TextBlock Text="promedio de modificaciones" FontSize="13" Foreground="{DynamicResource TextMuted}"/>
                        </StackPanel>
                    </Border>
                    
                </Grid>

                <Border Classes="card" Padding="18" CornerRadius="10">
                    <StackPanel Spacing="14">
                        <TextBlock x:Name="MetricsMonthLabel" Text="{Binding YearActual, StringFormat='Métricas globales del año {0}'}" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource AdminAccent}"/>
                        
                        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10" x:Name="MetricsGrid">
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Tareas creadas" FontSize="11" Foreground="{DynamicResource TextDisabled}"/>
                                <TextBlock Text="{Binding TareasCreadas}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1">
                                <TextBlock Text="Tareas completadas" FontSize="11" Foreground="{DynamicResource TextDisabled}"/>
                                <TextBlock Text="{Binding TareasCompletadas}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="Generaciones realizadas" FontSize="11" Foreground="{DynamicResource TextDisabled}"/>
                                <TextBlock Text="{Binding GeneracionesRealizadas}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <TextBlock Text="Generaciones modificadas" FontSize="11" Foreground="{DynamicResource TextDisabled}"/>
                                <TextBlock Text="0" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <TextBlock Text="Tareas en G.S." FontSize="11" Foreground="{DynamicResource TextDisabled}"/>
                                <TextBlock Text="0" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBlock Text="Tareas mod. en G.S." FontSize="11" Foreground="{DynamicResource TextDisabled}"/>
                                <TextBlock Text="{Binding TareasModificadasGS}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </Border>

                <!-- OBJETIVOS DEL PROYECTO (KPIs reales vs. meta). Al final y colapsable. -->
                <Expander Header="Objetivos del proyecto" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <ItemsControl ItemsSource="{Binding Objetivos}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ObjetivoKpi">
                                <Border Background="{DynamicResource AppBackground}" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0 0 0 8">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Titulo}" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Descripcion}" FontSize="11" Foreground="{DynamicResource TextDisabled}" TextWrapping="Wrap" Margin="0 2 12 0"/>

                                        <StackPanel Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
                                            <TextBlock Text="{Binding ValorTexto}" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Right"
                                                       Foreground="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding MetaTexto}" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                                <Border CornerRadius="4" Padding="7 1" Background="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}">
                                                    <TextBlock Text="{Binding TextoEstado}" FontSize="10" FontWeight="Bold" Foreground="#111827"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                        <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Margin="0 10 0 0" ColumnSpacing="10">
                                            <ProgressBar Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding Valor}" Height="6" VerticalAlignment="Center"
                                                         Foreground="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}" Background="{DynamicResource PillBackground}" CornerRadius="3"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Detalle}" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>