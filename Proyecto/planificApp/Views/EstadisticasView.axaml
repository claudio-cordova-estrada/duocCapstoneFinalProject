<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="planificApp.Views.EstadisticasView"
             xmlns:vm="clr-namespace:planificApp.ViewModels"
             x:DataType="vm:EstadisticasViewModel">

    <Border Background="{DynamicResource AppBackground}">
        <ScrollViewer>
            <StackPanel Spacing="18" Margin="28 26">

                <TextBlock Text="Estadísticas de usuario" FontSize="24" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Text="Datos de uso · actualizado hoy" FontSize="14" Foreground="{DynamicResource TextDisabled}" Margin="0 -12 0 0"/>

                <!-- Region pills -->
                <StackPanel Spacing="8">
                    <TextBlock Text="REGIÓN" FontSize="12" Foreground="{DynamicResource TextDisabled}" LetterSpacing="0.6"/>
                    <StackPanel Orientation="Horizontal" Spacing="6" x:Name="RegionPills"/>
                </StackPanel>

                <!-- Comuna pills -->
                <StackPanel Spacing="8">
                    <TextBlock Text="COMUNA" FontSize="12" Foreground="{DynamicResource TextDisabled}" LetterSpacing="0.6"/>
                    <StackPanel Orientation="Horizontal" Spacing="6" x:Name="ComunaPills"/>
                </StackPanel>

                <!-- Year/Month navigation -->
                <Border Classes="card" Padding="16" CornerRadius="10">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*">
                        <Button x:Name="YearLeft" Grid.Column="0" Classes="transparent" Padding="10" VerticalAlignment="Center" Click="YearLeft_Click">
                            <Label Content="&#xE51A;" FontFamily="{DynamicResource Phosphor}" FontSize="24" Foreground="{DynamicResource TextMuted}"/>
                        </Button>
                        <TextBlock x:Name="YearLabel" Grid.Column="1" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="10 0" MinWidth="72" TextAlignment="Center"/>
                        <Button x:Name="YearRight" Grid.Column="2" Classes="transparent" Padding="10" VerticalAlignment="Center" Click="YearRight_Click">
                            <Label Content="&#xE52C;" FontFamily="{DynamicResource Phosphor}" FontSize="24" Foreground="{DynamicResource TextMuted}"/>
                        </Button>
                        <Border Grid.Column="3" Width="1" Background="{DynamicResource BorderSubtle}" Margin="14 0"/>
                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" x:Name="MonthPills"/>
                    </Grid>
                </Border>

                <!-- Stat cards 2x2 -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" RowSpacing="10">
                    <Border Grid.Column="0" Grid.Row="0" Classes="card" Padding="20">
                        <StackPanel>
                            <TextBlock Text="TOTAL USUARIOS" FontSize="12" Foreground="{DynamicResource TextDisabled}" LetterSpacing="0.6"/>
                            <TextBlock x:Name="StatTotalUsuarios" FontSize="36" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0 8 0 4"/>
                            <TextBlock Text="registrados en la plataforma" FontSize="13" Foreground="{DynamicResource TextMuted}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Grid.Row="0" Classes="card" Padding="20">
                        <StackPanel>
                            <TextBlock Text="USUARIOS ACTIVOS" FontSize="12" Foreground="{DynamicResource TextDisabled}" LetterSpacing="0.6"/>
                            <TextBlock x:Name="StatUsuariosActivos" FontSize="36" FontWeight="SemiBold" Foreground="{DynamicResource AdminAccent}" Margin="0 8 0 4"/>
                            <TextBlock Text="con actividad reciente" FontSize="13" Foreground="{DynamicResource TextMuted}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="0" Grid.Row="1" Classes="card" Padding="20">
                        <StackPanel>
                            <TextBlock Text="USAN GENERACIÓN SEMANAL" FontSize="12" Foreground="{DynamicResource TextDisabled}" LetterSpacing="0.6"/>
                            <TextBlock x:Name="StatUsanGen" FontSize="36" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0 8 0 4"/>
                            <TextBlock x:Name="StatUsanGenSub" FontSize="13" Foreground="{DynamicResource TextMuted}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Grid.Row="1" Classes="card" Padding="20">
                        <StackPanel>
                            <TextBlock Text="CAMBIOS / GENERACIÓN" FontSize="12" Foreground="{DynamicResource TextDisabled}" LetterSpacing="0.6"/>
                            <TextBlock x:Name="StatCambiosGen" FontSize="36" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0 8 0 4"/>
                            <TextBlock Text="promedio de modificaciones" FontSize="13" Foreground="{DynamicResource TextMuted}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Metrics card -->
                <Border Classes="card" Padding="18" CornerRadius="10">
                    <StackPanel Spacing="14">
                        <TextBlock x:Name="MetricsMonthLabel" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource AdminAccent}"/>
                        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10" x:Name="MetricsGrid"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>