<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="600"
             x:Class="planificApp.Views.ConfigView"
             xmlns:vm="clr-namespace:planificApp.ViewModels"
             x:DataType="vm:ConfigViewModel">
    
    <Design.DataContext><vm:ConfigViewModel/></Design.DataContext>

    <Border Background="{DynamicResource AppBackground}">
        <ScrollViewer>
            <StackPanel Spacing="18" Margin="28 26">

                <TextBlock Text="Configuración" FontSize="22" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>

                <!-- Two-column layout -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="18">

                    <!-- Left: Configuraciones personales -->
                    <Border Grid.Column="0" Classes="card" Padding="20">
                        <StackPanel Spacing="16">
                            <TextBlock Text="Configuraciones personales" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>

                            <!-- Hora inicio actividades -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="HORA INICIO ACTIVIDADES" FontSize="11" Foreground="{DynamicResource TextDisabled}" LetterSpacing="0.6"/>
                                <Grid ColumnDefinitions="*,Auto,*,Auto">
                                    <TextBox x:Name="FieldInicioHoras" Grid.Column="0" IsReadOnly="True" Text="07" FontSize="14" Foreground="{DynamicResource TextSecondary}" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="0 4" HorizontalContentAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text=":" FontSize="14" Foreground="{DynamicResource TextDisabled}" VerticalAlignment="Center" Margin="6 0 6 0"/>
                                    <TextBox x:Name="FieldInicioMinutos" Grid.Column="2" IsReadOnly="True" Text="30" FontSize="14" Foreground="{DynamicResource TextSecondary}" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="0 4" HorizontalContentAlignment="Center"/>
                                    <Button x:Name="BtnHoraInicio" Grid.Column="3" Classes="transparent" Click="BtnHoraInicio_Click" VerticalAlignment="Center">
                                        <Label x:Name="IconHoraInicio" Content="&#xE3B2;" FontFamily="{DynamicResource Phosphor}" FontSize="15" Foreground="{DynamicResource TextMuted}"/>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- Hora fin actividades -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="HORA FIN ACTIVIDADES" FontSize="11" Foreground="{DynamicResource TextDisabled}" LetterSpacing="0.6"/>
                                <Grid ColumnDefinitions="*,Auto,*,Auto">
                                    <TextBox x:Name="FieldFinHoras" Grid.Column="0" IsReadOnly="True" Text="22" FontSize="14" Foreground="{DynamicResource TextSecondary}" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="0 4" HorizontalContentAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text=":" FontSize="14" Foreground="{DynamicResource TextDisabled}" VerticalAlignment="Center" Margin="6 0 6 0"/>
                                    <TextBox x:Name="FieldFinMinutos" Grid.Column="2" IsReadOnly="True" Text="00" FontSize="14" Foreground="{DynamicResource TextSecondary}" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="0 4" HorizontalContentAlignment="Center"/>
                                    <Button x:Name="BtnHoraFin" Grid.Column="3" Classes="transparent" Click="BtnHoraFin_Click" VerticalAlignment="Center">
                                        <Label x:Name="IconHoraFin" Content="&#xE3B2;" FontFamily="{DynamicResource Phosphor}" FontSize="15" Foreground="{DynamicResource TextMuted}"/>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <Border BorderBrush="{DynamicResource BorderDivider}" BorderThickness="0 0 0 1"/>

                            <!-- Ubicación predeterminada -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="UBICACIÓN PRED." FontSize="11" Foreground="{DynamicResource TextDisabled}" LetterSpacing="0.6"/>
                                <ComboBox x:Name="CbUbicacion" SelectedIndex="0" HorizontalAlignment="Stretch" FontSize="14">
                                    <ComboBoxItem Content="Casa"/>
                                    <ComboBoxItem Content="Oficina"/>
                                    <ComboBoxItem Content="Universidad"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Transporte predeterminado -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="TRANSPORTE PRED." FontSize="11" Foreground="{DynamicResource TextDisabled}" LetterSpacing="0.6"/>
                                <ComboBox x:Name="CbTransporte" SelectedIndex="0" HorizontalAlignment="Stretch" FontSize="14">
                                    <ComboBoxItem Content="Caminar"/>
                                    <ComboBoxItem Content="Auto"/>
                                    <ComboBoxItem Content="Bus"/>
                                    <ComboBoxItem Content="Metro"/>
                                    <ComboBoxItem Content="Bicicleta"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Horas de sueño -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="HORAS DE SUEÑO" FontSize="11" Foreground="{DynamicResource TextDisabled}" LetterSpacing="0.6"/>
                                <ComboBox x:Name="CbSueno" SelectedIndex="3" HorizontalAlignment="Stretch" FontSize="14">
                                    <ComboBoxItem Content="6"/>
                                    <ComboBoxItem Content="6.5"/>
                                    <ComboBoxItem Content="7"/>
                                    <ComboBoxItem Content="7.5"/>
                                    <ComboBoxItem Content="8"/>
                                    <ComboBoxItem Content="8.5"/>
                                    <ComboBoxItem Content="9"/>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Right: Días para generación semanal -->
                    <Border Grid.Column="1" Classes="card" Padding="20" VerticalAlignment="Top">
                        <StackPanel Spacing="16">
                            <TextBlock Text="Días para generación semanal" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Selecciona los días en los que deseas generar tu semana" FontSize="13" Foreground="{DynamicResource TextDisabled}" Margin="0 -10 0 0" HorizontalAlignment="Center"/>

                            <!-- Row 1: Lunes-Viernes -->
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Button x:Name="BtnLunes" Classes="pill-rounded active" Click="ToggleDia_Click" Width="100">
                                    <TextBlock Text="Lunes" FontSize="13" HorizontalAlignment="Center"/>
                                </Button>
                                <Button x:Name="BtnMartes" Classes="pill-rounded active" Click="ToggleDia_Click" Width="100">
                                    <TextBlock Text="Martes" FontSize="13" HorizontalAlignment="Center"/>
                                </Button>
                                <Button x:Name="BtnMiercoles" Classes="pill-rounded active" Click="ToggleDia_Click" Width="100">
                                    <TextBlock Text="Miércoles" FontSize="13" HorizontalAlignment="Center"/>
                                </Button>
                                <Button x:Name="BtnJueves" Classes="pill-rounded active" Click="ToggleDia_Click" Width="100">
                                    <TextBlock Text="Jueves" FontSize="13" HorizontalAlignment="Center"/>
                                </Button>
                                <Button x:Name="BtnViernes" Classes="pill-rounded active" Click="ToggleDia_Click" Width="100">
                                    <TextBlock Text="Viernes" FontSize="13" HorizontalAlignment="Center"/>
                                </Button>
                            </StackPanel>

                            <!-- Row 2: Sábado-Domingo -->
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Button x:Name="BtnSabado" Classes="pill-rounded" Click="ToggleDia_Click" Width="100">
                                    <TextBlock Text="Sábado" FontSize="13" HorizontalAlignment="Center"/>
                                </Button>
                                <Button x:Name="BtnDomingo" Classes="pill-rounded" Click="ToggleDia_Click" Width="100">
                                    <TextBlock Text="Domingo" FontSize="13" HorizontalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>