<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="600"
             x:Class="planificApp.Views.ConfigView"
             xmlns:vm="clr-namespace:planificApp.ViewModels"
             x:DataType="vm:ConfigViewModel">
    
    <Design.DataContext><vm:ConfigViewModel/></Design.DataContext>

    <Border Background="{DynamicResource AppBackground}">
        <ScrollViewer>
            <StackPanel Spacing="18" Margin="28 26">

                <TextBlock Text="Configuración" FontSize="22" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>

                <!-- Two-column layout -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="18">

                    <!-- Left: Configuraciones personales -->
                    <Border Grid.Column="0" Classes="card" Padding="20">
                        <StackPanel Spacing="16">
                            <TextBlock Text="Configuraciones personales" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>

                            <!-- Hora inicio actividades -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="HORA INICIO ACTIVIDADES" FontSize="11" Foreground="{DynamicResource TextDisabled}" LetterSpacing="0.6"/>
                                <Grid ColumnDefinitions="*,Auto,*,Auto">
                                    <TextBox Grid.Column="0" Text="{Binding HoraInicioHoras}" FontSize="14" Foreground="{DynamicResource TextSecondary}" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" Padding="0 4" HorizontalContentAlignment="Center" MaxLength="2"/>
                                    <TextBlock Grid.Column="1" Text=":" FontSize="14" Foreground="{DynamicResource TextDisabled}" VerticalAlignment="Center" Margin="6 0 6 0"/>
                                    <TextBox Grid.Column="2" Text="{Binding HoraInicioMinutos}" FontSize="14" Foreground="{DynamicResource TextSecondary}" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" Padding="0 4" HorizontalContentAlignment="Center" MaxLength="2"/>
                                    <Button Grid.Column="3" Classes="transparent" Padding="4" VerticalAlignment="Center" Command="{Binding ResetHoraInicioCommand}" Cursor="Hand">
                                        <Label FontFamily="{DynamicResource Phosphor}" FontSize="12" Content="&#xE4FA;" Foreground="{DynamicResource TextDisabled}" VerticalAlignment="Center"/>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- Hora fin actividades -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="HORA FIN ACTIVIDADES" FontSize="11" Foreground="{DynamicResource TextDisabled}" LetterSpacing="0.6"/>
                                <Grid ColumnDefinitions="*,Auto,*,Auto">
                                    <TextBox Grid.Column="0" Text="{Binding HoraFinHoras}" FontSize="14" Foreground="{DynamicResource TextSecondary}" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" Padding="0 4" HorizontalContentAlignment="Center" MaxLength="2"/>
                                    <TextBlock Grid.Column="1" Text=":" FontSize="14" Foreground="{DynamicResource TextDisabled}" VerticalAlignment="Center" Margin="6 0 6 0"/>
                                    <TextBox Grid.Column="2" Text="{Binding HoraFinMinutos}" FontSize="14" Foreground="{DynamicResource TextSecondary}" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" Padding="0 4" HorizontalContentAlignment="Center" MaxLength="2"/>
                                    <Button Grid.Column="3" Classes="transparent" Padding="4" VerticalAlignment="Center" Command="{Binding ResetHoraFinCommand}" Cursor="Hand">
                                        <Label FontFamily="{DynamicResource Phosphor}" FontSize="12" Content="&#xE4FA;" Foreground="{DynamicResource TextDisabled}" VerticalAlignment="Center"/>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <Border BorderBrush="{DynamicResource BorderDivider}" BorderThickness="0 0 0 1"/>

                            <!-- Ubicación de inicio -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="UBICACIÓN DE INICIO" FontSize="11" Foreground="{DynamicResource TextDisabled}" LetterSpacing="0.6"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                    <ComboBox Grid.Column="0" FontSize="14" Foreground="{DynamicResource TextSecondary}" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding MisUbicaciones}" SelectedItem="{Binding UbicacionInicioDisplay}"/>
                                    <Button Grid.Column="1" Classes="transparent" Padding="4" VerticalAlignment="Center" Command="{Binding ResetUbicacionCommand}" Cursor="Hand">
                                        <Label FontFamily="{DynamicResource Phosphor}" FontSize="12" Content="&#xE4FA;" Foreground="{DynamicResource TextDisabled}" VerticalAlignment="Center"/>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- Transporte predeterminado -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="TRANSPORTE PRED." FontSize="11" Foreground="{DynamicResource TextDisabled}" LetterSpacing="0.6"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                    <ComboBox Grid.Column="0" FontSize="14" Foreground="{DynamicResource TextSecondary}" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding OpcionesTransporte}" SelectedItem="{Binding TransporteDisplay}"/>
                                    <Button Grid.Column="1" Classes="transparent" Padding="4" VerticalAlignment="Center" Command="{Binding ResetTransporteCommand}" Cursor="Hand">
                                        <Label FontFamily="{DynamicResource Phosphor}" FontSize="12" Content="&#xE4FA;" Foreground="{DynamicResource TextDisabled}" VerticalAlignment="Center"/>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- Horas de sueño -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="HORAS DE SUEÑO" FontSize="11" Foreground="{DynamicResource TextDisabled}" LetterSpacing="0.6"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                    <ComboBox Grid.Column="0" FontSize="14" Foreground="{DynamicResource TextSecondary}" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding OpcionesHorasSueno}" SelectedItem="{Binding HorasSueno}"/>
                                    <Button Grid.Column="1" Classes="transparent" Padding="4" VerticalAlignment="Center" Command="{Binding ResetSuenoCommand}" Cursor="Hand">
                                        <Label FontFamily="{DynamicResource Phosphor}" FontSize="12" Content="&#xE4FA;" Foreground="{DynamicResource TextDisabled}" VerticalAlignment="Center"/>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- Warning/message -->
                            <TextBlock Text="{Binding Mensaje}" FontSize="12" Foreground="{DynamicResource DangerForeground}" HorizontalAlignment="Center" IsVisible="{Binding HayMensaje}" TextWrapping="Wrap" TextAlignment="Center"/>

                            <!-- Save button -->
                            <Button Classes="accent" HorizontalAlignment="Stretch" Command="{Binding GuardarCommand}">
                                <TextBlock Text="Guardar cambios" HorizontalAlignment="Center" FontSize="13"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Right: Días para generación semanal -->
                    <Border Grid.Column="1" Classes="card" Padding="20" VerticalAlignment="Top">
                        <StackPanel Spacing="16">
                            <TextBlock Text="Días para generación semanal" FontSize="15" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Selecciona los días en los que deseas generar tu semana" FontSize="13" Foreground="{DynamicResource TextDisabled}" Margin="0 -10 0 0" HorizontalAlignment="Center"/>

                            <!-- Row 1: Lunes-Viernes -->
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Button x:Name="BtnLunes" Classes="pill-rounded" Width="100" Click="ToggleDia_Click">
                                    <TextBlock Text="Lunes" FontSize="13" HorizontalAlignment="Center"/>
                                </Button>
                                <Button x:Name="BtnMartes" Classes="pill-rounded" Width="100" Click="ToggleDia_Click">
                                    <TextBlock Text="Martes" FontSize="13" HorizontalAlignment="Center"/>
                                </Button>
                                <Button x:Name="BtnMiercoles" Classes="pill-rounded" Width="100" Click="ToggleDia_Click">
                                    <TextBlock Text="Miércoles" FontSize="13" HorizontalAlignment="Center"/>
                                </Button>
                                <Button x:Name="BtnJueves" Classes="pill-rounded" Width="100" Click="ToggleDia_Click">
                                    <TextBlock Text="Jueves" FontSize="13" HorizontalAlignment="Center"/>
                                </Button>
                                <Button x:Name="BtnViernes" Classes="pill-rounded" Width="100" Click="ToggleDia_Click">
                                    <TextBlock Text="Viernes" FontSize="13" HorizontalAlignment="Center"/>
                                </Button>
                            </StackPanel>

                            <!-- Row 2: Sábado-Domingo -->
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Button x:Name="BtnSabado" Classes="pill-rounded" Width="100" Click="ToggleDia_Click">
                                    <TextBlock Text="Sábado" FontSize="13" HorizontalAlignment="Center"/>
                                </Button>
                                <Button x:Name="BtnDomingo" Classes="pill-rounded" Width="100" Click="ToggleDia_Click">
                                    <TextBlock Text="Domingo" FontSize="13" HorizontalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>