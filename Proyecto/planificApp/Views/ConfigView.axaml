<UserControl xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
         x:Class="planificApp.Views.ConfigView"
         xmlns:vm="clr-namespace:planificApp.ViewModels"
         x:DataType="vm:ConfigViewModel">
    <Border Background="{DynamicResource AppBackground}" Padding="22 26">
        <TextBlock Text="Config" FontSize="18" Foreground="{DynamicResource TextPrimary}" />
    </Border>
</UserControl>

