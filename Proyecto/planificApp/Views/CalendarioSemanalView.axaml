                        <Border Margin="0 1472 0 0" Height="1" Background="{DynamicResource CalendarHourLine}" HorizontalAlignment="Stretch" VerticalAlignment="Top"/>
                        <!-- 9:00-10:30 Trabajo top=576 h=94 single task -->
                        <Border Margin="2 576 2 0" Height="94" VerticalAlignment="Top" HorizontalAlignment="Stretch" Background="{DynamicResource AreaTrabajoBackground}" CornerRadius="5" BorderThickness="1 0 0 2" BorderBrush="{DynamicResource CalTrabajoBlockBorder}" ClipToBounds="True">
                            <Border Margin="4 3" Background="{DynamicResource AreaTrabajoChipBackground}" CornerRadius="3" Padding="4 2">
                                <TextBlock Text="Presentaci&#xF3;n" FontSize="10" Foreground="{DynamicResource AreaTrabajoText}" VerticalAlignment="Top" HorizontalAlignment="Stretch"/>
                            </Border>
                        </Border>
                        <!-- 16:00-17:00 Trabajo top=1024 h=62 single task -->
                        <Border Margin="2 1024 2 0" Height="62" VerticalAlignment="Top" HorizontalAlignment="Stretch" Background="{DynamicResource AreaTrabajoBackground}" CornerRadius="5" BorderThickness="1 0 0 2" BorderBrush="{DynamicResource CalTrabajoBlockBorder}" ClipToBounds="True">
                            <Border Margin="4 3" Background="{DynamicResource AreaTrabajoChipBackground}" CornerRadius="3" Padding="4 2">
                                <TextBlock FontSize="10" Foreground="{DynamicResource AreaTrabajoText}" VerticalAlignment="Top" HorizontalAlignment="Stretch" Text="Revisi&#xF3;n c&#xF3;digo"/>
                            </Border>
                        </Border>
                    </Panel>

                    <!-- S&#xC1;BADO (Col 6) 9-11 Estudio -->
                    <Panel Grid.Column="6" Height="1536" ClipToBounds="False">
                        <Border Margin="0 64 0 0" Height="1" Background="{DynamicResource CalendarHourLine}" HorizontalAlignment="Stretch" VerticalAlignment="Top"/>
                        <Border Margin="0 128 0 0" Height="1" Background="{DynamicResource CalendarHourLine}" HorizontalAlignment="Stretch" VerticalAlignment="Top"/>
                        <Border Margin="0 192 0 0" Height="1" Background="{DynamicResource CalendarHourLine}" HorizontalAlignment="Stretch" VerticalAlignment="Top"/>
                        <Border Margin="0 256 0 0" Height="1" Background="{DynamicResource CalendarHourLine}" HorizontalAlignment="Stretch" VerticalAlignment="Top"/>
                        <Border Margin="0 320 0 0" Height="1" Background="{DynamicResource CalendarHourLine}" HorizontalAlignment="Stretch" VerticalAlignment="Top"/>
                        <Border Margin="0 384 0 0" Height="1" Background="{DynamicResource CalendarHourLine}" HorizontalAlignment="Stretch" VerticalAlignment="Top"/>
