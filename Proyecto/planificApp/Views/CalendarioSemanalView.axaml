<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="planificApp.Views.CalendarioSemanalView"
             xmlns:vm="clr-namespace:planificApp.ViewModels"
             xmlns:models="clr-namespace:PlanificApp.Models;assembly=planificApp"
             x:DataType="vm:CalendarioSemanalViewModel">

    <Border Background="{DynamicResource AppBackground}">
        <DockPanel>

            <!-- Sub-header -->
            <Border DockPanel.Dock="Top" Padding="10 14" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0 0 0 1">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                    <Button Grid.Column="0" Classes="transparent" Padding="4" VerticalAlignment="Center"
                            Command="{Binding SemanaAnteriorCommand}">
                        <Label Classes="icon-only" Content="&#xE51A;" FontSize="16" Foreground="{DynamicResource TextSecondary}"/>
                    </Button>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding NumeroSemana}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding FechaRango}" FontSize="11" Foreground="{DynamicResource TextDisabled}" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="2" Classes="transparent" Padding="4" VerticalAlignment="Center"
                            Command="{Binding SemanaSiguienteCommand}">
                        <Label Classes="icon-only" Content="&#xE52C;" FontSize="16" Foreground="{DynamicResource TextSecondary}"/>
                    </Button>
                    <Button Grid.Column="3" Classes="transparent" Padding="8 4" VerticalAlignment="Center"
                            Command="{Binding IrHoyCommand}">
                        <TextBlock Text="Hoy" FontSize="12" Foreground="{DynamicResource AccentColor}"/>
                    </Button>
                    <Button Grid.Column="4" Classes="accent" IsEnabled="False" Margin="12 0 0 0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Label Classes="icon-btn" Content="&#xE6B6;" FontSize="14"/>
                            <TextBlock Text="Generar semana" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Legend -->
            <Border DockPanel.Dock="Bottom" Padding="6 10" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0 1 0 0">
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <ItemsControl ItemsSource="{Binding AreasDisponibles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="14"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:AreaInteres">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="12" Height="12" CornerRadius="2"
                                            Background="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                            BorderBrush="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}" BorderThickness="1" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Nombre}" FontSize="13" Foreground="{DynamicResource TextDisabled}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Width="12" Height="12" CornerRadius="2" Background="{DynamicResource TrasladoBackground}" BorderBrush="{DynamicResource TrasladoBorder}" BorderThickness="1 0 0 2" VerticalAlignment="Center"/>
                        <TextBlock Text="Traslado" FontSize="13" Foreground="{DynamicResource TextDisabled}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Main content: Grid + Panel -->
            <Grid ColumnDefinitions="*,210">

                <!-- Calendar grid area -->
                <Grid Grid.Column="0" RowDefinitions="Auto,*">

                    <!-- Day headers -->
                    <Border Grid.Row="0" Background="{DynamicResource CalendarDayHeader}">
                        <Grid x:Name="DayHeaderGrid" ColumnDefinitions="52,190,190,190,190,190,190,190">
                            <TextBlock Grid.Column="0" Text="" FontSize="9" Margin="0 0 4 0" HorizontalAlignment="Right"/>
                            <Border x:Name="DayHeader0" Grid.Column="1" Padding="4 6">
                                <StackPanel HorizontalAlignment="Center" Spacing="1">
                                    <TextBlock x:Name="DayHeader0_Name" FontSize="9" Foreground="{DynamicResource TextDisabled}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="DayHeader0_Num" FontSize="12" Foreground="{DynamicResource TextDisabled}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="DayHeader1" Grid.Column="2" Padding="4 6">
                                <StackPanel HorizontalAlignment="Center" Spacing="1">
                                    <TextBlock x:Name="DayHeader1_Name" FontSize="9" Foreground="{DynamicResource TextDisabled}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="DayHeader1_Num" FontSize="12" Foreground="{DynamicResource TextDisabled}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="DayHeader2" Grid.Column="3" Padding="4 6">
                                <StackPanel HorizontalAlignment="Center" Spacing="1">
                                    <TextBlock x:Name="DayHeader2_Name" FontSize="9" Foreground="{DynamicResource TextDisabled}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="DayHeader2_Num" FontSize="12" Foreground="{DynamicResource TextDisabled}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="DayHeader3" Grid.Column="4" Padding="4 6">
                                <StackPanel HorizontalAlignment="Center" Spacing="1">
                                    <TextBlock x:Name="DayHeader3_Name" FontSize="9" Foreground="{DynamicResource TextDisabled}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="DayHeader3_Num" FontSize="12" Foreground="{DynamicResource TextDisabled}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="DayHeader4" Grid.Column="5" Padding="4 6">
                                <StackPanel HorizontalAlignment="Center" Spacing="1">
                                    <TextBlock x:Name="DayHeader4_Name" FontSize="9" Foreground="{DynamicResource TextDisabled}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="DayHeader4_Num" FontSize="12" Foreground="{DynamicResource TextDisabled}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="DayHeader5" Grid.Column="6" Padding="4 6">
                                <StackPanel HorizontalAlignment="Center" Spacing="1">
                                    <TextBlock x:Name="DayHeader5_Name" FontSize="9" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="DayHeader5_Num" FontSize="12" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="DayHeader6" Grid.Column="7" Padding="4 6">
                                <StackPanel HorizontalAlignment="Center" Spacing="1">
                                    <TextBlock x:Name="DayHeader6_Name" FontSize="9" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="DayHeader6_Num" FontSize="12" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Scrollable time grid -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  x:Name="CalendarScrollViewer">
                        <Grid ColumnDefinitions="52,*,*,*,*,*,*,*" x:Name="CalendarGrid">

                            <!-- Vertical column separators -->
                            <Border Grid.Column="1" Width="1" HorizontalAlignment="Left" Background="{DynamicResource BorderSubtle}"/>
                            <Border Grid.Column="2" Width="1" HorizontalAlignment="Left" Background="{DynamicResource BorderSubtle}"/>
                            <Border Grid.Column="3" Width="1" HorizontalAlignment="Left" Background="{DynamicResource BorderSubtle}"/>
                            <Border Grid.Column="4" Width="1" HorizontalAlignment="Left" Background="{DynamicResource BorderSubtle}"/>
                            <Border Grid.Column="5" Width="1" HorizontalAlignment="Left" Background="{DynamicResource BorderSubtle}"/>
                            <Border Grid.Column="6" Width="1" HorizontalAlignment="Left" Background="{DynamicResource BorderSubtle}"/>
                            <Border Grid.Column="7" Width="1" HorizontalAlignment="Left" Background="{DynamicResource BorderSubtle}"/>

                            <!-- Time labels column -->
                            <StackPanel Grid.Column="0">
                                <Border Height="64"><TextBlock Classes="cal-time" Text="0:00" Margin="0 0 4 0" HorizontalAlignment="Right" VerticalAlignment="Top"/></Border>
                                <Border Height="64"><TextBlock Classes="cal-time" Text="1:00" Margin="0 0 4 0" HorizontalAlignment="Right" VerticalAlignment="Top"/></Border>
                                <Border Height="64"><TextBlock Classes="cal-time" Text="2:00" Margin="0 0 4 0" HorizontalAlignment="Right" VerticalAlignment="Top"/></Border>
                                <Border Height="64"><TextBlock Classes="cal-time" Text="3:00" Margin="0 0 4 0" HorizontalAlignment="Right" VerticalAlignment="Top"/></Border>
                                <Border Height="64"><TextBlock Classes="cal-time" Text="4:00" Margin="0 0 4 0" HorizontalAlignment="Right" VerticalAlignment="Top"/></Border>
                                <Border Height="64"><TextBlock Classes="cal-time" Text="5:00" Margin="0 0 4 0" HorizontalAlignment="Right" VerticalAlignment="Top"/></Border>
                                <Border Height="64"><TextBlock Classes="cal-time" Text="6:00" Margin="0 0 4 0" HorizontalAlignment="Right" VerticalAlignment="Top"/></Border>
                                <Border Height="64"><TextBlock Classes="cal-time" Text="7:00" Margin="0 0 4 0" HorizontalAlignment="Right" VerticalAlignment="Top"/></Border>
                                <Border Height="64"><TextBlock Classes="cal-time" Text="8:00" Margin="0 0 4 0" HorizontalAlignment="Right" VerticalAlignment="Top"/></Border>
                                <Border Height="64"><TextBlock Classes="cal-time" Text="9:00" Margin="0 0 4 0" HorizontalAlignment="Right" VerticalAlignment="Top"/></Border>
                                <Border Height="64"><TextBlock Classes="cal-time" Text="10:00" Margin="0 0 4 0" HorizontalAlignment="Right" VerticalAlignment="Top"/></Border>
                                <Border Height="64"><TextBlock Classes="cal-time" Text="11:00" Margin="0 0 4 0" HorizontalAlignment="Right" VerticalAlignment="Top"/></Border>
                                <Border Height="64"><TextBlock Classes="cal-time" Text="12:00" Margin="0 0 4 0" HorizontalAlignment="Right" VerticalAlignment="Top"/></Border>
                                <Border Height="64"><TextBlock Classes="cal-time" Text="13:00" Margin="0 0 4 0" HorizontalAlignment="Right" VerticalAlignment="Top"/></Border>
                                <Border Height="64"><TextBlock Classes="cal-time" Text="14:00" Margin="0 0 4 0" HorizontalAlignment="Right" VerticalAlignment="Top"/></Border>
                                <Border Height="64"><TextBlock Classes="cal-time" Text="15:00" Margin="0 0 4 0" HorizontalAlignment="Right" VerticalAlignment="Top"/></Border>
                                <Border Height="64"><TextBlock Classes="cal-time" Text="16:00" Margin="0 0 4 0" HorizontalAlignment="Right" VerticalAlignment="Top"/></Border>
                                <Border Height="64"><TextBlock Classes="cal-time" Text="17:00" Margin="0 0 4 0" HorizontalAlignment="Right" VerticalAlignment="Top"/></Border>
                                <Border Height="64"><TextBlock Classes="cal-time" Text="18:00" Margin="0 0 4 0" HorizontalAlignment="Right" VerticalAlignment="Top"/></Border>
                                <Border Height="64"><TextBlock Classes="cal-time" Text="19:00" Margin="0 0 4 0" HorizontalAlignment="Right" VerticalAlignment="Top"/></Border>
                                <Border Height="64"><TextBlock Classes="cal-time" Text="20:00" Margin="0 0 4 0" HorizontalAlignment="Right" VerticalAlignment="Top"/></Border>
                                <Border Height="64"><TextBlock Classes="cal-time" Text="21:00" Margin="0 0 4 0" HorizontalAlignment="Right" VerticalAlignment="Top"/></Border>
                                <Border Height="64"><TextBlock Classes="cal-time" Text="22:00" Margin="0 0 4 0" HorizontalAlignment="Right" VerticalAlignment="Top"/></Border>
                                <Border Height="64"><TextBlock Classes="cal-time" Text="23:00" Margin="0 0 4 0" HorizontalAlignment="Right" VerticalAlignment="Top"/></Border>
                            </StackPanel>

                            <!-- 7 day columns -->
                            <Panel x:Name="Day0" Grid.Column="1" Height="1536" ClipToBounds="False"/>
                            <Panel x:Name="Day1" Grid.Column="2" Height="1536" ClipToBounds="False"/>
                            <Panel x:Name="Day2" Grid.Column="3" Height="1536" ClipToBounds="False"/>
                            <Panel x:Name="Day3" Grid.Column="4" Height="1536" ClipToBounds="False"/>
                            <Panel x:Name="Day4" Grid.Column="5" Height="1536" ClipToBounds="False"/>
                            <Panel x:Name="Day5" Grid.Column="6" Height="1536" ClipToBounds="False"/>
                            <Panel x:Name="Day6" Grid.Column="7" Height="1536" ClipToBounds="False"/>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- Panel de tareas (derecha) -->
                <Border Grid.Column="1" Background="{DynamicResource SB2Background}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1 0 0 0" Width="210">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="0">
                            <!-- Header -->
                            <Border Padding="12 10" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0 0 0 1">
                                <TextBlock Text="Tareas" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Areas con tareas -->
                            <ItemsControl ItemsSource="{Binding AreasConTareas}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:AreaConTareas">
                                        <StackPanel Spacing="2" Margin="0 4 0 0">
                                            <Border Padding="10 6" Background="{DynamicResource HoverBackground}" CornerRadius="4" Cursor="Hand">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Left" Width="8" Height="8" CornerRadius="2" Margin="0 0 8 0" VerticalAlignment="Center"
                                                            Background="{Binding Area.ColorHex, Converter={StaticResource HexToBrushConverter}}"/>
                                                    <TextBlock Text="{Binding Area.Nombre}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </Border>
                                            <ItemsControl Margin="18 2 0 2" ItemsSource="{Binding Tareas}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:Tarea">
                                                        <Border Padding="6 4" Margin="2 1" Background="{DynamicResource CardBackground}"
                                                                CornerRadius="3" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1"
                                                                Cursor="Hand">
                                                            <TextBlock Text="{Binding Nombre}" FontSize="10" Foreground="{DynamicResource TextSecondary}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Loading overlay -->
            <Border IsVisible="{Binding IsLoading}" Background="#00000088" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <TextBlock Text="Cargando..." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#ffffff" FontSize="14"/>
            </Border>

        </DockPanel>
    </Border>
</UserControl>