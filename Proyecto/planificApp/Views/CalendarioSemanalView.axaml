                        <Border Margin="0 576 0 0" Height="1" Background="{DynamicResource CalendarHourLine}" HorizontalAlignment="Stretch" VerticalAlignment="Top"/>
                        <Border Margin="0 640 0 0" Height="1" Background="{DynamicResource CalendarHourLine}" HorizontalAlignment="Stretch" VerticalAlignment="Top"/>
                        <Border Margin="0 704 0 0" Height="1" Background="{DynamicResource CalendarHourLine}" HorizontalAlignment="Stretch" VerticalAlignment="Top"/>
                        <Border Margin="0 768 0 0" Height="1" Background="{DynamicResource CalendarHourLine}" HorizontalAlignment="Stretch" VerticalAlignment="Top"/>
