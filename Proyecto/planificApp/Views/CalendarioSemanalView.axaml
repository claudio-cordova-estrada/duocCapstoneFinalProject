                    </Panel>

                    <!-- Vertical day separators -->
                    <Border Grid.Column="2" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1 0 0 0" Height="1536" VerticalAlignment="Top"/>
                    <Border Grid.Column="3" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1 0 0 0" Height="1536" VerticalAlignment="Top"/>
                    <Border Grid.Column="5" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1 0 0 0" Height="1536" VerticalAlignment="Top"/>
