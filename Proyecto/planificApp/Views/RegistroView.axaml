<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="800"
             x:Class="planificApp.Views.RegistroView"
             xmlns:vm="clr-namespace:planificApp.ViewModels"
             x:DataType="vm:RegistroViewModel">

    <Border Background="{DynamicResource AppBackground}">
        <Grid RowDefinitions="*,Auto,*">
            
            <Border Grid.Row="0"/>
            
            <Border Grid.Row="1" Classes="card" Padding="40" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    
                    <StackPanel HorizontalAlignment="Center" Spacing="8" Margin="0 0 0 4">
                        <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource AccentBackground}" HorizontalAlignment="Center">
                            <Label Classes="icon-only" Content="&#xEA3A;" Foreground="{DynamicResource AccentColor}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Crear cuenta" FontSize="22" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Regístrate para empezar a planificar" FontSize="13" Foreground="{DynamicResource TextDisabled}" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="NOMBRE COMPLETO" FontSize="11" Foreground="{DynamicResource TextDisabled}" LetterSpacing="0.6"/>
                        <TextBox Text="{Binding NombreCompleto}" FontSize="14" PlaceholderText="Tu nombre" Foreground="{DynamicResource TextSecondary}" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="CORREO ELECTRÓNICO" FontSize="11" Foreground="{DynamicResource TextDisabled}" LetterSpacing="0.6"/>
                        <TextBox Text="{Binding Correo}" FontSize="14" PlaceholderText="correo@ejemplo.com" Foreground="{DynamicResource TextSecondary}" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Text="CONTRASEÑA" FontSize="11" Foreground="{DynamicResource TextDisabled}" LetterSpacing="0.6"/>
                            <TextBox Text="{Binding Password}" FontSize="14" PasswordChar="*" PlaceholderText="Contraseña" Foreground="{DynamicResource TextSecondary}" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="REPETIR CONTRASEÑA" FontSize="11" Foreground="{DynamicResource TextDisabled}" LetterSpacing="0.6"/>
                            <TextBox Text="{Binding RepetirPassword}" FontSize="14" PasswordChar="*" PlaceholderText="Repetir contraseña" Foreground="{DynamicResource TextSecondary}" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="6">
                        <TextBlock Text="FECHA DE NACIMIENTO" FontSize="11" Foreground="{DynamicResource TextDisabled}" LetterSpacing="0.6"/>
                        <CalendarDatePicker x:Name="DatePickerNacimiento" FontSize="14" Foreground="{DynamicResource TextSecondary}" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" PlaceholderText="Selecciona tu fecha de nacimiento" HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                        
                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Text="REGIÓN" FontSize="11" Foreground="{DynamicResource TextDisabled}" LetterSpacing="0.6"/>
                            <ComboBox ItemsSource="{Binding Regiones}"
                                      SelectedItem="{Binding RegionSeleccionada}"
                                      PlaceholderText="Selecciona región"
                                      HorizontalAlignment="Stretch"
                                      Foreground="{DynamicResource TextSecondary}" 
                                      Background="{DynamicResource InputBackground}" 
                                      BorderBrush="{DynamicResource InputBorder}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="COMUNA" FontSize="11" Foreground="{DynamicResource TextDisabled}" LetterSpacing="0.6"/>
                            <ComboBox ItemsSource="{Binding ComunasDisponibles}"
                                      SelectedItem="{Binding ComunaSeleccionada}"
                                      IsEnabled="{Binding ComunasHabilitadas}"
                                      PlaceholderText="Selecciona comuna"
                                      HorizontalAlignment="Stretch"
                                      Foreground="{DynamicResource TextSecondary}" 
                                      Background="{DynamicResource InputBackground}" 
                                      BorderBrush="{DynamicResource InputBorder}"/>
                        </StackPanel>
                        
                    </Grid>

                    <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" FontSize="12" Foreground="{DynamicResource DangerForeground}" HorizontalAlignment="Center" TextWrapping="Wrap"/>

                    <Button Classes="accent" HorizontalAlignment="Stretch" Click="CrearCuenta_Click" Margin="0 4 0 0">
                        <TextBlock Text="Crear cuenta" FontSize="14" HorizontalAlignment="Center"/>
                    </Button>

                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="4" Margin="0 4 0 0">
                        <TextBlock Text="¿Ya tienes cuenta?" FontSize="12" Foreground="{DynamicResource TextDisabled}" VerticalAlignment="Center"/>
                        <Button Classes="transparent" Command="{Binding GoToLoginCommand}" Padding="4 2">
                            <TextBlock Text="Iniciar sesión" FontSize="12" Foreground="{DynamicResource AccentColor}"/>
                        </Button>
                    </StackPanel>

                </StackPanel>
            </Border>

            <Border Grid.Row="2"/>
            
        </Grid>
    </Border>
</UserControl>