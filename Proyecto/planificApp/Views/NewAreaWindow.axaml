<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="520"
        x:Class="planificApp.Views.NewAreaWindow"
        xmlns:vm="clr-namespace:planificApp.ViewModels"
        x:DataType="vm:NewAreaViewModel"
        Title="{Binding Titulo}"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        Width="480"
        CanResize="False"
        Background="{DynamicResource ModalBackground}">

    <Border Classes="modal-panel" Margin="0" Padding="24">
        <StackPanel Spacing="14">

            <TextBlock Text="Nueva área de interés" FontSize="16" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>

            <!-- Nombre -->
            <StackPanel Spacing="4">
                <TextBlock Text="NOMBRE" FontSize="11" Foreground="{DynamicResource TextDisabled}" LetterSpacing="0.6"/>
                <TextBox Text="{Binding Nombre}" FontSize="14" PlaceholderText="Nombre del área" Foreground="{DynamicResource TextSecondary}" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}"/>
            </StackPanel>

            <!-- Color y prioridad -->
            <Grid ColumnDefinitions="*, *">
                <!-- Color -->
                <StackPanel Spacing="4">
                    <TextBlock Text="COLOR" FontSize="11" Foreground="{DynamicResource TextDisabled}" LetterSpacing="0.6"/>
                    <StackPanel Orientation="Horizontal" Spacing="7" x:Name="ColorGrid">
                        <Border Classes="color-opt" Background="#a78bfa" Tag="#a78bfa" Tapped="ColorOption_Tapped"/>
                        <Border Classes="color-opt" Background="#34d399" Tag="#34d399" Tapped="ColorOption_Tapped"/>
                        <Border Classes="color-opt" Background="#f472b6" Tag="#f472b6" Tapped="ColorOption_Tapped"/>
                        <Border Classes="color-opt" Background="#60a5fa" Tag="#60a5fa" Tapped="ColorOption_Tapped"/>
                        <Border Classes="color-opt" Background="#fb923c" Tag="#fb923c" Tapped="ColorOption_Tapped"/>
                        <Border Classes="color-opt" Background="#facc15" Tag="#facc15" Tapped="ColorOption_Tapped"/>
                        <Border Classes="color-opt" Background="#f87171" Tag="#f87171" Tapped="ColorOption_Tapped"/>
                        <Border Classes="color-opt" Background="#2dd4bf" Tag="#2dd4bf" Tapped="ColorOption_Tapped"/>
                    </StackPanel>
                </StackPanel>
                
                <!-- Prioridad -->
                <StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="PRIORIDAD DEL ÁREA" FontSize="11" Foreground="{DynamicResource TextDisabled}" LetterSpacing="0.6"/>
                    <ComboBox x:Name="CmbPrioridadArea" SelectedIndex="0" FontSize="13" Foreground="{DynamicResource TextSecondary}" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="1 - Baja"/>
                        <ComboBoxItem Content="2 - Media"/>
                        <ComboBoxItem Content="3 - Alta"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <!-- Ubicacion predeterminada -->
            <StackPanel Spacing="4">
                <TextBlock Text="UBICACIÓN PREDETERMINADA" FontSize="11" Foreground="{DynamicResource TextDisabled}" LetterSpacing="0.6"/>
                <ComboBox ItemsSource="{Binding UbicacionesGuardadasLista}"
          SelectedItem="{Binding UbicacionSeleccionada}"
          DisplayMemberBinding="{Binding Nombre}" 
          PlaceholderText="— Sin ubicación —"
          HorizontalAlignment="Stretch">
</ComboBox>
            </StackPanel>

            <Grid ColumnDefinitions="*, *">
                <!-- Horas semanales -->
                <StackPanel Spacing="4" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="HORAS SEMANALES" FontSize="11" Foreground="{DynamicResource TextDisabled}" LetterSpacing="0.6"/>
                    <TextBox x:Name="TxtHorasSemanales" Text="{Binding HorasSemanales}" FontSize="14" PlaceholderText="0" Foreground="{DynamicResource TextSecondary}" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}"/>
                </StackPanel>
                
                <!-- Metodo transporte predeterminado -->
                <StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="TRANSPORTE PREDETERMINADO" FontSize="11" Foreground="{DynamicResource TextDisabled}" LetterSpacing="0.6"/>
                    <ComboBox x:Name="CmbTransporte" SelectedIndex="0" FontSize="13" Foreground="{DynamicResource TextSecondary}" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="— Sin transporte —"/>
                        <ComboBoxItem Content="Caminar"/>
                        <ComboBoxItem Content="Auto"/>
                        <ComboBoxItem Content="Bus"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <!-- Actividad física predeterminada -->
            <StackPanel Spacing="4">
                <TextBlock Text="ACTIVIDAD FÍSICA PREDETERMINADA" FontSize="11" Foreground="{DynamicResource TextDisabled}" LetterSpacing="0.6"/>
                <ComboBox x:Name="CmbTipoActividadFisicaPred" SelectedIndex="0" FontSize="13" Foreground="{DynamicResource TextSecondary}" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="— Ninguna —"/>
                    <ComboBoxItem Content="Activa"/>
                    <ComboBoxItem Content="Pasiva"/>
                </ComboBox>
            </StackPanel>

            <!-- Actividad mental predeterminada -->
            <StackPanel Spacing="4">
                <TextBlock Text="ACTIVIDAD MENTAL PREDETERMINADA" FontSize="11" Foreground="{DynamicResource TextDisabled}" LetterSpacing="0.6"/>
                <ComboBox x:Name="CmbTipoActividadMentalPred" SelectedIndex="0" FontSize="13" Foreground="{DynamicResource TextSecondary}" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="— Ninguna —"/>
                    <ComboBoxItem Content="Obligación"/>
                    <ComboBoxItem Content="Recreación"/>
                </ComboBox>
            </StackPanel>

            <!-- Error message -->
            <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" FontSize="12" Foreground="{DynamicResource DangerForeground}" HorizontalAlignment="Center" TextWrapping="Wrap"/>

            <!-- Buttons -->
            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0 6 0 0">
                <Border Width="0" Grid.Column="0"/>
                <Button Grid.Column="1" Classes="transparent" Margin="0 0 8 0" Click="CancelButton_Click" Content="Cancelar"/>
                <Button Grid.Column="2" Classes="accent" Click="SaveButton_Click" Content="Guardar"/>
            </Grid>

        </StackPanel>
    </Border>
</Window>