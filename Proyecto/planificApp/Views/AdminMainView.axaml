<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="800"
        x:Class="planificApp.AdminMainView"
        xmlns:vm="clr-namespace:planificApp.ViewModels"
        x:DataType="vm:AdminMainViewModel"
        Title="PlanificApp — Admin">
    
    <Grid Background="{DynamicResource AppBackground}" ColumnDefinitions="56,*">
        
        <!-- SB1 — Admin Icon Navigation -->
        <Border Grid.Column="0" Background="{DynamicResource SB1Background}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0 0 1 0">
            <Border Padding="0 12">
                <StackPanel Spacing="2">
                    <!-- Logo (Shield) -->
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AdminAccentBackground}" HorizontalAlignment="Center" Margin="0 0 0 14">
                        <Label Classes="icon-only" Content="&#xE465;" Foreground="{DynamicResource AdminAccent}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    
                    <!-- Estadísticas -->
                    <Button Classes="sb1-item admin" Classes.active="{Binding IsEstadisticasActive}" Command="{Binding GoToEstadisticasCommand}">
                        <Label Classes="icon-only" Content="&#xE712;" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    
                    <!-- Usuarios -->
                    <Button Classes="sb1-item admin" Classes.active="{Binding IsUsuariosActive}" Command="{Binding GoToUsuariosCommand}">
                        <Label Classes="icon-only" Content="&#xE47D;" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Border>
        </Border>
        
        <!-- Main Content -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}"/>
        
    </Grid>
</Window>