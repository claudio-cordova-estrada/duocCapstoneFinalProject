<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="800"
        x:Class="planificApp.AdminMainView"
        xmlns:vm="clr-namespace:planificApp.ViewModels"
        x:DataType="vm:AdminMainViewModel"
        Title="PlanificApp — Admin">
        
    <Design.DataContext>
        <vm:AdminMainViewModel/>
    </Design.DataContext>
    
    <Grid Background="{DynamicResource AppBackground}" ColumnDefinitions="56,*">
        
        <!-- SB1 — Admin Icon Navigation -->
        <Border Grid.Column="0" Background="{DynamicResource SB1Background}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0 0 1 0">
            <Border Padding="0 12">
                <StackPanel Spacing="2">
                <!-- Logo (Shield) -->
                <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AdminAccentBackground}" HorizontalAlignment="Center" Margin="0 0 0 14">
                    <Label Classes="icon-only" Content="&#xE46A;" Foreground="{DynamicResource AdminAccent}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                
                <!-- Estadísticas -->
                <Button Classes="sb1-item admin" Command="{Binding GoToEstadisticasCommand}" IsVisible="{Binding IsEstadisticasActive}">
                    <Label Classes="icon-only" Content="&#xE4E5;" FontSize="18"/>
                </Button>
                <Button Classes="sb1-item admin" Command="{Binding GoToEstadisticasCommand}" IsVisible="{Binding !IsEstadisticasActive}">
                    <Label Classes="icon-only" Content="&#xE4E5;" FontSize="18"/>
                </Button>
                
                <!-- Usuarios -->
                <Button Classes="sb1-item admin" Command="{Binding GoToUsuariosCommand}" IsVisible="{Binding IsUsuariosActive}">
                    <Label Classes="icon-only" Content="&#xE491;" FontSize="18"/>
                </Button>
                <Button Classes="sb1-item admin" Command="{Binding GoToUsuariosCommand}" IsVisible="{Binding !IsUsuariosActive}">
                    <Label Classes="icon-only" Content="&#xE491;" FontSize="18"/>
                </Button>
                </StackPanel>
            </Border>
        </Border>
        
        <!-- Main Content -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}"/>
        
    </Grid>
</Window>
