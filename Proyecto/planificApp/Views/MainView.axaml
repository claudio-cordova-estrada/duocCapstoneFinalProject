<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="800"
        x:Class="planificApp.MainView"
        xmlns:vm="clr-namespace:planificApp.ViewModels"
        x:DataType="vm:MainViewModel"
        Title="PlanificApp"
        MinWidth="960" MinHeight="600">
    
    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>

    <LayoutTransformControl HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <LayoutTransformControl.LayoutTransform>
            <ScaleTransform ScaleX="{DynamicResource AppFontScale}" ScaleY="{DynamicResource AppFontScale}"/>
        </LayoutTransformControl.LayoutTransform>

    <Grid Background="{DynamicResource AppBackground}">
        
        <!-- Auth overlay (visible when NOT logged in) -->
        <Border IsVisible="{Binding !IsLoggedIn}" Background="{DynamicResource AppBackground}">
            <Panel>
                <ContentControl Content="{Binding CurrentPage}"/>
                <Button Classes="sb1-item" Command="{Binding ToggleThemeCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16" ToolTip.Tip="Cambiar tema claro / oscuro">
                    <PathIcon Width="17" Height="17" Data="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
                </Button>
            </Panel>
        </Border>

        <!-- App layout (visible when logged in) -->
        <Grid ColumnDefinitions="56,Auto,*" IsVisible="{Binding IsLoggedIn}">
            
            <!-- SB1 — Icon Navigation (User mode) -->
            <Border Grid.Column="0" Background="{DynamicResource SB1Background}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0 0 1 0" IsVisible="{Binding !IsAdminToggle}">
                <Border Padding="0 12">
                    <Grid ColumnDefinitions="Auto" RowDefinitions="*, Auto, Auto, Auto" HorizontalAlignment="Center">
                        <StackPanel Spacing="10">
                            <!-- Logo -->
                            <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AccentBackground}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 0 0 14">
                                <Label Classes="icon-only" Content="&#xEA3A;" Foreground="{DynamicResource AccentColor}" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            
                            <IconButton IconText="&#xE464;" Classes="sb1-item" Classes.active="{Binding IsTareasActive}" Command="{Binding GoToTareasCommand}" />
                            <IconButton IconText="&#xE712;" Classes="sb1-item" Classes.active="{Binding IsCalendarioActive}" Command="{Binding GoToCalendarioCommand}" />
                            <IconButton IconText="&#xE318;" Classes="sb1-item" Classes.active="{Binding IsUbicacionesActive}" Command="{Binding GoToUbicacionesCommand}" />
                            
                            <Border Height="1"/>
                        </StackPanel>
                        <Button Grid.Row="1" Classes="sb1-item" Command="{Binding ToggleThemeCommand}" ToolTip.Tip="Cambiar tema claro / oscuro">
                            <PathIcon Width="17" Height="17" Data="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
                        </Button>
                        <IconButton Grid.Row="2" IconText="&#xE4C2;" Classes="sb1-item" Classes.active="{Binding IsCuentaActive}" Command="{Binding GoToCuentaCommand}" />
                        <IconButton Grid.Row="3" IconText="&#xE270;" Classes="sb1-item" Classes.active="{Binding IsConfigActive}" Command="{Binding GoToConfigCommand}" />
                    </Grid>
                </Border>
            </Border>
            
            <!-- SB1 — Icon Navigation (Admin mode) -->
            <Border Grid.Column="0" Background="{DynamicResource SB1Background}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0 0 1 0" IsVisible="{Binding IsAdminToggle}">
                <Border Padding="0 12">
                    <Grid ColumnDefinitions="Auto" RowDefinitions="*, Auto, Auto" HorizontalAlignment="Center">
                        <StackPanel Spacing="10">
                            <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AdminAccentBackground}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 0 0 14">
                                <Label Classes="icon-only" Content="&#xEA3A;" Foreground="{DynamicResource AdminAccent}" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>

                            <Button Classes="sb1-item admin" Classes.active="{Binding IsAdminEstadisticasActive}" Command="{Binding GoToAdminEstadisticasCommand}">
                                <Label Classes="icon-only" Content="&#xEAA6;" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>

                            <Button Classes="sb1-item admin" Classes.active="{Binding IsAdminUsuariosActive}" Command="{Binding GoToAdminUsuariosCommand}">
                                <Label Classes="icon-only" Content="&#xE2C8;" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                        <Button Grid.Row="1" Classes="sb1-item" Command="{Binding ToggleThemeCommand}" ToolTip.Tip="Cambiar tema claro / oscuro">
                            <PathIcon Width="17" Height="17" Data="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
                        </Button>
                        <IconButton Grid.Row="2" IconText="&#xE42A;" Classes="sb1-item" Command="{Binding LogoutCommand}" />
                    </Grid>
                </Border>
            </Border>
            
            <!-- SB2 — Sub Navigation (dynamic, hidden in admin mode) -->
            <Border Grid.Column="1" Width="168" Background="{DynamicResource SB2Background}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0 0 1 0" IsVisible="{Binding ShowSB2}">
                <ScrollViewer>
                    <StackPanel>
                        <!-- Tareas SB2 -->
                        <StackPanel IsVisible="{Binding IsTareasActive}">
                            <TextBlock Classes="sb2-header">Tareas</TextBlock>
                            <Button Classes="sb2-item" Classes.active="{Binding IsInboxActive}" Command="{Binding GoToInboxCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <Label Classes="icon-only" Content="&#xE464;" FontSize="15" Width="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="Inbox" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="sb2-item" Classes.active="{Binding IsHoyActive}" Command="{Binding GoToHoyCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <Label Classes="icon-only" Content="&#xE10A;" FontSize="15" Width="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="Hoy" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="sb2-item" Classes.active="{Binding IsSemanaActive}" Command="{Binding GoToSemanaCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <Label Classes="icon-only" Content="&#xE7B2;" FontSize="15" Width="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="Semana" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="sb2-item" Classes.active="{Binding IsMesActive}" Command="{Binding GoToMesCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <Label Classes="icon-only" Content="&#xE7B4;" FontSize="15" Width="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="Mes" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            
                            <Border Classes="divider" Margin="12 6"/>
                            
                            <Grid ColumnDefinitions="*,Auto" Margin="0 0 15 0">
                                <TextBlock Classes="sb2-section" Text="Áreas de interés" FontSize="13"/>
                                <Button Grid.Column="1" Classes="transparent" Padding="2" 
                                        Click="NewAreaInteresButton_Click" Cursor="Hand">
                                    <Label Classes="icon-btn" Content="&#xE3D4;" FontSize="14"
                                           Foreground="{DynamicResource TextDisabled}" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding AreasInteres}" x:CompileBindings="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
<Button Classes="sb2-item" Command="{Binding DataContext.GoToAreaEspecificaCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal" Spacing="9">
                                                <Ellipse Width="7" Height="7" Fill="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Nombre}" FontSize="13" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Editar área" Click="EditarAreaMenuItem_Click"/>
                                                    <MenuItem Header="Eliminar área" Click="EliminarAreaMenuItem_Click"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            
                            
                        </StackPanel>
                        
                        <!-- Calendario SB2 -->
                        <StackPanel IsVisible="{Binding IsCalendarioActive}">
                            <TextBlock Classes="sb2-header">Calendario</TextBlock>
                            <Button Classes="sb2-item" Classes.active="{Binding IsCalSemanalActive}" Command="{Binding GoToCalendarioSemanalCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <Label Classes="icon-only" Content="&#xE712;" FontSize="15" Width="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="Semanal" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="sb2-item" Classes.active="{Binding IsCalMensualActive}" Command="{Binding GoToCalendarioMensualCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <Label Classes="icon-only" Content="&#xE712;" FontSize="15" Width="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="Mensual" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        
                        <!-- Cuenta SB2 -->
                        <StackPanel IsVisible="{Binding IsCuentaActive}">
                            <TextBlock Classes="sb2-header">Mi cuenta</TextBlock>
                            <Button Classes="sb2-item" Classes.active="{Binding IsDatosActive}" Command="{Binding GoToDatosCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <Label Classes="icon-only" Content="&#xE4C4;" FontSize="15" Width="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="Mis datos" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="sb2-item" Classes.active="{Binding IsSoporteActive}" Command="{Binding GoToSoporteCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <Label Classes="icon-only" Content="&#xE584;" FontSize="15" Width="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="Soporte" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="sb2-item" Classes.active="{Binding IsSobreActive}" Command="{Binding GoToSobreCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <Label Classes="icon-only" Content="&#xE2CE;" FontSize="15" Width="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="Sobre la app" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Border Classes="divider" Margin="12 6"/>

                            <Button Classes="sb2-item" Command="{Binding LogoutCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <Label Classes="icon-only" Content="&#xE42A;" FontSize="15" Width="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource DangerForeground}"/>
                                    <TextBlock Text="Logout" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource DangerForeground}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            
            <!-- Main Content -->
            <ContentControl Grid.Column="2" Content="{Binding CurrentPage}"/>

        </Grid>

        <!-- Overlay para la transición suave de tema (claro <-> oscuro) -->
        <Border x:Name="ThemeFadeOverlay" IsHitTestVisible="False" IsVisible="False" Opacity="0"/>

    </Grid>
    </LayoutTransformControl>
</Window>