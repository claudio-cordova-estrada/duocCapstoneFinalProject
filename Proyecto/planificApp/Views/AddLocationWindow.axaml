<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="planificApp.Views.AddLocationWindow"
        Title="PlanificApp"
        Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource ModalBackground}"
        ExtendClientAreaToDecorationsHint="True">

    <Border Background="{DynamicResource ModalBackground}" BorderBrush="{DynamicResource ModalBorder}" BorderThickness="1" CornerRadius="12" Padding="22">
        <StackPanel Spacing="16">

            <StackPanel Spacing="5">
                <TextBlock Text="NOMBRE" FontSize="10" Foreground="{DynamicResource TextDisabled}" LetterSpacing="0.6"/>
                <TextBox x:Name="NameInput" PlaceholderText="Ej: Casa, Oficina&#x2026;"/>
                <TextBlock x:Name="NameError" Text="El nombre no puede estar vacío" FontSize="11" Foreground="#ef4444" IsVisible="False"/>
            </StackPanel>

            <StackPanel Spacing="5">
                <TextBlock Text="UBICACIÓN" FontSize="10" Foreground="{DynamicResource TextDisabled}" LetterSpacing="0.6"/>
                <AutoCompleteBox x:Name="LocationInput" PlaceholderText="Buscar dirección…" FilterMode="None"/>
            </StackPanel>

            <StackPanel Spacing="5">
                <TextBlock Text="ÁREA DE INTERÉS" FontSize="10" Foreground="{DynamicResource TextDisabled}" LetterSpacing="0.6"/>
                <ComboBox x:Name="AreaSelect" HorizontalAlignment="Stretch"/>
            </StackPanel>

            <StackPanel Spacing="5">
                <TextBlock Text="COLOR" FontSize="10" Foreground="{DynamicResource TextDisabled}" LetterSpacing="0.6"/>
                <StackPanel Orientation="Horizontal" Spacing="7" x:Name="ColorGrid">
                    <Border Classes="color-opt" Background="#a78bfa" Tag="#a78bfa" Tapped="ColorOption_Tapped"/>
                    <Border Classes="color-opt" Background="#34d399" Tag="#34d399" Tapped="ColorOption_Tapped"/>
                    <Border Classes="color-opt" Background="#f472b6" Tag="#f472b6" Tapped="ColorOption_Tapped"/>
                    <Border Classes="color-opt" Background="#60a5fa" Tag="#60a5fa" Tapped="ColorOption_Tapped"/>
                    <Border Classes="color-opt" Background="#fb923c" Tag="#fb923c" Tapped="ColorOption_Tapped"/>
                    <Border Classes="color-opt" Background="#facc15" Tag="#facc15" Tapped="ColorOption_Tapped"/>
                    <Border Classes="color-opt" Background="#f87171" Tag="#f87171" Tapped="ColorOption_Tapped"/>
                    <Border Classes="color-opt" Background="#2dd4bf" Tag="#2dd4bf" Tapped="ColorOption_Tapped"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="5">
                <TextBlock Text="TRANSPORTE HABITUAL" FontSize="10" Foreground="{DynamicResource TextDisabled}" LetterSpacing="0.6"/>
                <StackPanel Orientation="Horizontal" Spacing="5" x:Name="TransportGrid">
                    <Border Classes="transport-pill" Tag="Metro" Tapped="TransportOption_Tapped">
                        <TextBlock Text="Metro" FontSize="11" Foreground="{DynamicResource TextDisabled}" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Classes="transport-pill" Tag="Bus" Tapped="TransportOption_Tapped">
                        <TextBlock Text="Bus" FontSize="11" Foreground="{DynamicResource TextDisabled}" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Classes="transport-pill" Tag="Auto" Tapped="TransportOption_Tapped">
                        <TextBlock Text="Auto" FontSize="11" Foreground="{DynamicResource TextDisabled}" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Classes="transport-pill" Tag="Taxi" Tapped="TransportOption_Tapped">
                        <TextBlock Text="Taxi" FontSize="11" Foreground="{DynamicResource TextDisabled}" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Classes="transport-pill" Tag="Bicicleta" Tapped="TransportOption_Tapped">
                        <TextBlock Text="Bicicleta" FontSize="11" Foreground="{DynamicResource TextDisabled}" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Classes="transport-pill" Tag="A pie" Tapped="TransportOption_Tapped">
                        <TextBlock Text="A pie" FontSize="11" Foreground="{DynamicResource TextDisabled}" HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </StackPanel>

            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0 4 0 0">
                <Button x:Name="DeleteButton" Grid.Column="0" Classes="danger" HorizontalAlignment="Left" IsVisible="False" Click="DeleteButton_Click">
                    <TextBlock Text="Cancelar" FontSize="12"/>
                </Button>
                <Button Grid.Column="1" Classes="transparent" HorizontalAlignment="Right" Click="CancelButton_Click" Margin="0 0 8 0">
                    <TextBlock Text="Cancelar" FontSize="12" Foreground="{DynamicResource TextDisabled}"/>
                </Button>
                <Button Grid.Column="2" Classes="accent" Click="SaveButton_Click">
                    <TextBlock Text="Guardar" FontSize="12"/>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</Window>