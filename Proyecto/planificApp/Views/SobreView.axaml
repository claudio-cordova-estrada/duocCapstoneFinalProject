<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="planificApp.Views.SobreView"
             xmlns:vm="clr-namespace:planificApp.ViewModels"
             x:DataType="vm:SobreViewModel">

    <Border Background="{DynamicResource AppBackground}">
        <ScrollViewer>
            <StackPanel Spacing="18" Margin="28 26">

                <TextBlock Text="Sobre la app" FontSize="22" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>

                <!-- App info card -->
                <Border Classes="card" Padding="20">
                    <StackPanel Spacing="16">
                        <!-- Logo + name row -->
                        <Grid ColumnDefinitions="Auto,*" Margin="0 0 0 6">
                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12" Background="{DynamicResource AccentBackground}" Margin="0 0 14 0">
                                <Label Classes="icon-only" Content="&#xEA3A;" FontFamily="{DynamicResource Phosphor}" FontSize="22" Foreground="{DynamicResource AccentColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="PlanificApp" FontSize="17" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="Versi&#xF3;n 1.0.0 &#xB7; Avalonia UI" FontSize="13" Foreground="{DynamicResource TextDisabled}" Margin="0 2 0 0"/>
                            </StackPanel>
                        </Grid>

                        <Border BorderBrush="{DynamicResource BorderDivider}" BorderThickness="0 0 0 1"/>

                        <TextBlock Text="PlanificApp es una aplicaci&#xF3;n de gesti&#xF3;n de tareas con planificaci&#xF3;n semanal inteligente. Permite organizar actividades por &#xE1;reas de inter&#xE9;s, asociarlas a ubicaciones y calcular tiempos de traslado." FontSize="14" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" LineHeight="24"/>

                        <TextBlock Text="El generador semanal analiza tus &#xE1;reas, prioridades y restricciones horarias para construir una semana equilibrada." FontSize="13" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" LineHeight="22"/>

                        <TextBlock Text="Desarrollado con C# &#xB7; .NET &#xB7; Avalonia UI" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0 6 0 0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>