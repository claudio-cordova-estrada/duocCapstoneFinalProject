<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="planificApp.Views.MesView"
             xmlns:vm="clr-namespace:planificApp.ViewModels"
             x:DataType="vm:MesViewModel">

    <ScrollViewer>
        <Border Padding="28 26" Background="{DynamicResource AppBackground}">
            <StackPanel Spacing="20">

                <!-- Header -->
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="3">
                        <TextBlock Text="Mayo 2026" FontSize="20" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="32 tareas este mes" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="accent" VerticalAlignment="Center" Click="NewTaskButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Label Classes="icon-btn" Content="&#xE4A0;" FontSize="14"/>
                            <TextBlock Text="Nueva tarea" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Add task input -->
                <TextBox Classes="add-task"/>

                <!-- Stats -->
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Classes="card" Padding="16 12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="18" FontSize="22" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="Pendientes" FontSize="10" Foreground="{DynamicResource TextDisabled}"/>
                        </StackPanel>
                    </Border>
                    <Border Classes="card" Padding="16 12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="12" FontSize="22" FontWeight="Medium" Foreground="{DynamicResource AreaEstudioText}"/>
                            <TextBlock Text="Completadas" FontSize="10" Foreground="{DynamicResource TextDisabled}"/>
                        </StackPanel>
                    </Border>
                    <Border Classes="card" Padding="16 12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="3" FontSize="22" FontWeight="Medium" Foreground="{DynamicResource DangerForeground}"/>
                            <TextBlock Text="Vencidas" FontSize="10" Foreground="{DynamicResource TextDisabled}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 7 de mayo -->
                <TextBlock Classes="section-label" Text="7 DE MAYO"/>

                <Border Classes="card">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0">
                        <Border Classes="task-check" Grid.Column="0" VerticalAlignment="Center" Margin="0 0 12 0"/>
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="Enviar informe semanal" Foreground="{DynamicResource TextPrimary}" FontSize="13"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Classes="badge-info" VerticalAlignment="Center">
                                    <TextBlock Text="Trabajo" FontSize="9" Foreground="{DynamicResource BadgeInfoForeground}"/>
                                </Border>
                                <Label Classes="icon-btn" Content="&#xE318;" FontSize="11" Foreground="{DynamicResource TextDisabled}" VerticalAlignment="Center"/>
                                <TextBlock Text="Oficina central" FontSize="10" Foreground="{DynamicResource TextDisabled}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="10:00" FontSize="11" Foreground="{DynamicResource TextDisabled}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Classes="card">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0">
                        <Border Classes="task-check" Grid.Column="0" VerticalAlignment="Center" Margin="0 0 12 0"/>
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="Reunión de equipo" Foreground="{DynamicResource TextPrimary}" FontSize="13"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Classes="badge-info" VerticalAlignment="Center">
                                    <TextBlock Text="Trabajo" FontSize="9" Foreground="{DynamicResource BadgeInfoForeground}"/>
                                </Border>
                                <TextBlock Text="14:00" FontSize="10" Foreground="{DynamicResource TextDisabled}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="14:00" FontSize="11" Foreground="{DynamicResource TextDisabled}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Classes="card">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0">
                        <Border Classes="task-check" Grid.Column="0" VerticalAlignment="Center" Margin="0 0 12 0"/>
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="Clase de spinning" Foreground="{DynamicResource TextPrimary}" FontSize="13"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Background="{DynamicResource AreaDeporteBackground}" CornerRadius="4" Padding="7 2" VerticalAlignment="Center">
                                    <TextBlock Text="Deporte" FontSize="9" Foreground="{DynamicResource AreaDeporteText}"/>
                                </Border>
                                <TextBlock Text="18:00" FontSize="10" Foreground="{DynamicResource TextDisabled}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="18:00" FontSize="11" Foreground="{DynamicResource TextDisabled}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 9 de mayo -->
                <TextBlock Classes="section-label" Text="9 DE MAYO"/>

                <Border Classes="card">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0">
                        <Border Classes="task-check" Grid.Column="0" VerticalAlignment="Center" Margin="0 0 12 0"/>
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="Estudiar capítulo 5" Foreground="{DynamicResource TextPrimary}" FontSize="13"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Background="{DynamicResource AreaEstudioBackground}" CornerRadius="4" Padding="7 2" VerticalAlignment="Center">
                                    <TextBlock Text="Estudio" FontSize="9" Foreground="{DynamicResource AreaEstudioText}"/>
                                </Border>
                                <Label Classes="icon-btn" Content="&#xE318;" FontSize="11" Foreground="{DynamicResource TextDisabled}" VerticalAlignment="Center"/>
                                <TextBlock Text="Biblioteca DUOC" FontSize="10" Foreground="{DynamicResource TextDisabled}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="09:00" FontSize="11" Foreground="{DynamicResource TextDisabled}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 13 de mayo -->
                <TextBlock Classes="section-label" Text="13 DE MAYO"/>

                <Border Classes="card">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0">
                        <Border Classes="task-check" Grid.Column="0" VerticalAlignment="Center" Margin="0 0 12 0"/>
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="Revisión de código" Foreground="{DynamicResource TextPrimary}" FontSize="13"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Classes="badge-info" VerticalAlignment="Center">
                                    <TextBlock Text="Trabajo" FontSize="9" Foreground="{DynamicResource BadgeInfoForeground}"/>
                                </Border>
                                <TextBlock Text="16:00" FontSize="10" Foreground="{DynamicResource TextDisabled}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="16:00" FontSize="11" Foreground="{DynamicResource TextDisabled}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 15 de mayo -->
                <TextBlock Classes="section-label" Text="15 DE MAYO"/>

                <Border Classes="card">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0">
                        <Border Classes="task-check" Grid.Column="0" VerticalAlignment="Center" Margin="0 0 12 0"/>
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="Preparar presentación proyecto" Foreground="{DynamicResource TextPrimary}" FontSize="13"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Classes="badge-info" VerticalAlignment="Center">
                                    <TextBlock Text="Trabajo" FontSize="9" Foreground="{DynamicResource BadgeInfoForeground}"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="Todo el día" FontSize="11" Foreground="{DynamicResource TextDisabled}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 19 de mayo -->
                <TextBlock Classes="section-label" Text="19 DE MAYO"/>

                <Border Classes="card">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0">
                        <Border Classes="task-check" Grid.Column="0" VerticalAlignment="Center" Margin="0 0 12 0"/>
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="Clase de yoga" Foreground="{DynamicResource TextPrimary}" FontSize="13"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Background="{DynamicResource AreaDeporteBackground}" CornerRadius="4" Padding="7 2" VerticalAlignment="Center">
                                    <TextBlock Text="Deporte" FontSize="9" Foreground="{DynamicResource AreaDeporteText}"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="07:00" FontSize="11" Foreground="{DynamicResource TextDisabled}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Vencidas -->
                <TextBlock Classes="section-label" Text="VENCIDAS"/>

                <Border Classes="card" BorderBrush="{DynamicResource DangerBorder}">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0">
                        <Border Classes="task-check" Grid.Column="0" VerticalAlignment="Center" Margin="0 0 12 0" BorderBrush="{DynamicResource DangerForeground}"/>
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="Revisión contrato" Foreground="{DynamicResource DangerForeground}" FontSize="13"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Classes="badge-danger" VerticalAlignment="Center">
                                    <TextBlock Text="Vencida" FontSize="9" Foreground="{DynamicResource BadgeDangerForeground}"/>
                                </Border>
                                <Border Classes="badge-info" VerticalAlignment="Center">
                                    <TextBlock Text="Trabajo" FontSize="9" Foreground="{DynamicResource BadgeInfoForeground}"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="6 may" FontSize="11" Foreground="{DynamicResource DangerForeground}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Classes="card" BorderBrush="{DynamicResource DangerBorder}">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0">
                        <Border Classes="task-check" Grid.Column="0" VerticalAlignment="Center" Margin="0 0 12 0" BorderBrush="{DynamicResource DangerForeground}"/>
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="Entrega parcial 2" Foreground="{DynamicResource DangerForeground}" FontSize="13"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Classes="badge-danger" VerticalAlignment="Center">
                                    <TextBlock Text="Vencida" FontSize="9" Foreground="{DynamicResource BadgeDangerForeground}"/>
                                </Border>
                                <Border Background="{DynamicResource AreaEstudioBackground}" CornerRadius="4" Padding="7 2" VerticalAlignment="Center">
                                    <TextBlock Text="Estudio" FontSize="9" Foreground="{DynamicResource AreaEstudioText}"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="3 may" FontSize="11" Foreground="{DynamicResource DangerForeground}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>