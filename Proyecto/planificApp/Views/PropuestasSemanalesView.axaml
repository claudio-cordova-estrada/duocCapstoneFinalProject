<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="planificApp.Views.PropuestasSemanalesView"
             xmlns:vm="clr-namespace:planificApp.ViewModels"
             xmlns:models="clr-namespace:PlanificApp.Models;assembly=planificApp"
             x:DataType="vm:PropuestasSemanalesViewModel">

    <Border Background="{DynamicResource AppBackground}">
        <DockPanel>

            <Border DockPanel.Dock="Top" Padding="16 14" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0 0 0 1">
                <StackPanel HorizontalAlignment="Center" Spacing="3">
                    <TextBlock Text="Propuestas semanales" FontSize="16" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Basado en tus &#xE1;reas de inter&#xE9;s y tareas" FontSize="12" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Padding="16" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0 1 0 0"
                    IsVisible="{Binding IsLoading}">
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                    <Button Classes="accent" Command="{Binding GenerarPropuestasCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Label Classes="icon-btn" Content="&#xE6B6;" FontSize="14"/>
                            <TextBlock Text="Regenerar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <ScrollViewer>
                <StackPanel Spacing="16" Margin="24">

                    <Border IsVisible="{Binding IsLoading}" Background="{DynamicResource HoverBackground}" CornerRadius="8" Padding="20">
                        <TextBlock Text="Generando propuestas..." FontSize="14" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                    </Border>

                    <Border IsVisible="{Binding MensajeError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Background="#33ff6666" CornerRadius="8" Padding="16">
                        <TextBlock Text="{Binding MensajeError}" FontSize="13" Foreground="#ff6666" TextWrapping="Wrap"/>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Propuestas}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="card" Padding="16" Margin="0 0 0 16">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="3">
                                                <TextBlock Text="{Binding Nombre}" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                                                <TextBlock Text="{Binding Descripcion}" FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock FontSize="11" Foreground="{DynamicResource TextDisabled}">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0} bloques - {1} tareas">
                                                            <Binding Path="TotalBloques"/>
                                                            <Binding Path="TotalTareas"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>

                                        <Border IsVisible="{Binding EsValida, Converter={x:Static BoolConverters.Not}}"
                                                Padding="8" CornerRadius="4" Background="#33ff6666">
                                            <TextBlock Text="{Binding MensajeInvalidacion}" FontSize="11" Foreground="#ff6666" TextWrapping="Wrap"/>
                                        </Border>

                                        <!-- Mini weekly preview -->
                                        <Border IsVisible="{Binding EsValida}" Background="{DynamicResource CardBackground}" CornerRadius="6" Padding="8" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                            <ItemsControl ItemsSource="{Binding Semana.Dias}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Spacing="4"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnDefinitions="48,*,Auto" Margin="0 2">
                                                            <TextBlock Grid.Column="0" Text="{Binding NombreDia}" FontSize="10" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                                                <ItemsControl ItemsSource="{Binding Bloques}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <StackPanel Orientation="Horizontal" Spacing="2"/>
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
<DataTemplate>
                                                                        <Border Background="{Binding ColorHex, FallbackValue=#a78bfa}" CornerRadius="3" Padding="4 2" Opacity="0.7" MinWidth="16">
                                                                            <TextBlock FontSize="9" Foreground="#ffffff" TextTrimming="CharacterEllipsis" MaxWidth="80"
                                                                                       Text="{Binding NombreMostrar}"/>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" FontSize="9" Foreground="{DynamicResource TextDisabled}" VerticalAlignment="Center">
                                                                <TextBlock.Text>
                                                                    <MultiBinding StringFormat="{}{0:F1}h">
                                                                        <Binding Path="Bloques.Count"/>
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>

                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                                <TextBlock FontSize="11" Foreground="{DynamicResource TextDisabled}" Text="{Binding HorasFuncionalesUsadas, StringFormat='{}{0:F1} hrs funcionales'}"/>
                                                <TextBlock FontSize="11" Foreground="{DynamicResource TextDisabled}" Text="{Binding DiasSeleccionadosCount, StringFormat='{}{0} d&#xED;as'}"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Classes="transparent" Margin="0 0 8 0"
                                                    IsEnabled="{Binding EsValida}" Command="{Binding $parent[ItemsControl].((vm:PropuestasSemanalesViewModel)DataContext).PrevisualizarCommand}" CommandParameter="{Binding}">
                                                <TextBlock Text="Previsualizar" FontSize="12"/>
                                            </Button>
                                            <Button Grid.Column="3" Classes="accent"
                                                    IsEnabled="{Binding EsValida}" Command="{Binding $parent[ItemsControl].((vm:PropuestasSemanalesViewModel)DataContext).SeleccionarPropuestaCommand}" CommandParameter="{Binding}">
                                                <TextBlock Text="Generar" FontSize="12"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>